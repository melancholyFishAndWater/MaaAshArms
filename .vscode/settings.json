{
    "json.schemas": [
        {
            "fileMatch": [
                "/assets/resource/pipeline/**/*.json",
                "/assets/resource/config/**/*.json",
                "/assets/resource/model/**/*.json",
                "/install/resource/pipeline/**/*.json",
                "/install/resource/config/**/*.json",
                "/install/resource/model/**/*.json",
                "/assets/resource/pipeline/**/*.jsonc",
                "/assets/resource/config/**/*.jsonc",
                "/assets/resource/model/**/*.jsonc",
                "/install/resource/pipeline/**/*.jsonc",
                "/install/resource/config/**/*.jsonc",
                "/install/resource/model/**/*.jsonc"
            ],
            "url": "/deps/tools/pipeline.schema.json"
        },
        {
            "fileMatch": [
                "/assets/interface.json",
                "/install/interface.json"
            ],
            "url": "/deps/tools/interface.schema.json"
        },
        {
            "fileMatch": [
                "/install/config/maa_pi_config.json"
            ],
            "url": "/deps/tools/interface_config.schema.json"
        },
        {
            "fileMatch": [
                "/assets/resource/tasks/*.json",
                "/assets/resource/tasks/**/*.json",
                "/assets/resource/tasks/*.jsonc",
                "/assets/resource/tasks/**/*.jsonc",
                "/install/resource/tasks/*.json",
                "/install/resource/tasks/**/*.json",
                "/install/resource/tasks/*.jsonc",
                "/install/resource/tasks/**/*.jsonc"
            ],
            "url": "/deps/tools/interface_import.schema.json"
        }
    ],
    "files.associations": {
        "**/assets/**/*.json": "jsonc"
    },
    "[json][jsonc]": {
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.indentSize": "tabSize"
    },
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "[markdown]": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    "python.REPL.enableREPLSmartSend": false,
    "python.analysis.exclude": [
        "**/build",
        "**/install",
        "**/temp",
        "**/deps"
    ],
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/.python-runtime*/**": true,
        "**/build/**": true,
        "**/install/**": true,
        "**/temp/**": true,
        "**/deps/**": true,
        "**/debug/**": true,
        "**/docs/node_modules/**": true,
        "**/docs/.vuepress/.temp/**": true
    },
    "search.exclude": {
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/.python-runtime*/**": true,
        "**/build/**": true,
        "**/install/**": true,
        "**/temp/**": true,
        "**/deps/**": true,
        "**/debug/**": true,
        "**/docs/node_modules/**": true
    },
    "files.exclude": {
        "build": true,
        "temp": true,
        ".python-runtime-linux": true,
        ".python-runtime-osx": true,
        "node_modules": true,
        "docs/node_modules": true,
        "**/__pycache__": true
    }
}