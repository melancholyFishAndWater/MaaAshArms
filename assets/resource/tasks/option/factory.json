{
    // 订单工厂
    "option": {
        "自定义数量": {
            "type": "input",
            "description": "单次建造几个Arms，超过3个时，要开启跳过才生效",
            "inputs": [
                {
                    "name": "build_amrs_number",
                    "label": "建造数量",
                    "default": "3",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "pattern_msg": "请输入数字"
                },
                {
                    "name": "build_number",
                    "label": "单次建造几个",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]$|^10$",
                    "pattern_msg": "请输入数字"
                }
            ],
            "pipeline_override": {
                "FactoryCheckTaskEnd": {
                    "custom_recognition_param": "{build_amrs_number}"
                },
                "FactoryChooseNumber": {
                    "custom_recognition_param": "{build_number}"
                }
            }
        },
        "build_skip": {
            "type": "switch",
            "label": "跳过建造等待",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "FactorySkip": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        }
    }
}