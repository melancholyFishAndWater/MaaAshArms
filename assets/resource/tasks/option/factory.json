{
    // 订单工厂
    "option": {
        "build_number": {
            "type": "input",
            "label": "自定义建造个数",
            "inputs": [
                {
                    "name": "build_amrs_number",
                    "label": "单次建造几个",
                    "default": "1",
                    "pipeline_type": "int",
                    "verify": "^[1-9]$|^10$",
                    "pattern_msg": "请输入数字"
                }
            ],
            "pipeline_override": {
                "FactoryChooseNumber": {
                    "custom_recognition_param": "{build_amrs_number}"
                }
            }
        },
        "build_times": {
            "label": "自定义建造次数",
            "type": "input",
            "inputs": [
                {
                    "name": "build_amrs_times",
                    "label": "建造次数",
                    "default": "3",
                    "pipeline_type": "int",
                    "verify": "^\\d+$",
                    "pattern_msg": "请输入数字"
                }
            ],
            "pipeline_override": {
                "FactoryCheckTaskEnd": {
                    "custom_recognition_param": "{build_amrs_times}"
                }
            }
        },
        "build_skip": {
            "type": "switch",
            "label": "跳过建造等待",
            "default_case": "No",
            "cases": [
                {
                    "name": "No"
                },
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "FactorySkip": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "factory_daily": {
            "type": "switch",
            "label": "每日一次",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "FactoryCheckTaskEnd": {
                            // INFO 每日任务要求造三个
                            "custom_recognition_param": 3
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "TaskFactory": {
                            "custom_recognition_param": {
                                "enable": false
                            }
                        }
                    },
                    "option": [
                        "build_times"
                    ]
                }
            ]
        }
    }
}