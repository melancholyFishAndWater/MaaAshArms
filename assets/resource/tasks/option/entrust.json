{
    "option": {
        "entrust_daily": {
            "type": "switch",
            "label": "每日一次",
            "cases": [
                {
                    "name": "Yes"
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "EntrustProbeDaily": {
                            "custom_recognition_param": {
                                "enable": false
                            }
                        }
                    }
                }
            ]
        },
        "entrust_inputs": {
            "label": "相关配置",
            "type": "input",
            "inputs": [
                {
                    "name": "stage_name",
                    "label": "关卡名",
                    "default": "结晶废墟",
                    "pipeline_type": "string",
                    "description": "输入关卡名称"
                },
                {
                    "name": "level",
                    "label": "关卡小节",
                    "default": "10",
                    "pipeline_type": "int",
                    "verify": "^([1-9]|10)$",
                    "description": "请输入1~10"
                },
                {
                    "name": "times",
                    "label": "委派次数",
                    "default": "30",
                    "pipeline_type": "int",
                    "verify": "^([1-9]|[1-2][0-9]|30)$",
                    "description": "请输入1~30。与剩余次数取最小值"
                }
            ],
            "pipeline_override": {
                "EntrustInit": {
                    "attach": {
                        "stage_name": "{stage_name}",
                        "level": "{level}",
                        "times": "{times}"
                    }
                }
            }
        }
    }
}