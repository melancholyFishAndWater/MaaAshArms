    // INFO 任务入口
    "TaskReward": {
        "desc": "领取奖励任务",
        "timeout": 60000,
        "next": [
            "[JumpBack]EntrustRewardableNow",
            "[JumpBack]ShopEnterHome",
            "[JumpBack]MissionBranchReward",
            "[JumpBack]SikuBranchReward",
            "[JumpBack]BaseBranchError",
            "[JumpBack]BaseReturnHome",
            "BaseTaskStop"
        ]
    },
    /* -------------------- 通用探测 -------------------- */
    // 有任务奖励
    "MissionProbeRewardable": {
        "desc": "[end] 有任务奖励",
        "recognition": "TemplateMatch",
        "template": "Base/BlueMarkGreen.png",
        "green_mask": true,
        "roi": [
            885,
            602,
            63,
            60
        ]
    },
    /* -------------------- 分支-任务奖励 -------------------- */
    "MissionBranchReward": {
        "desc": "[once] 任务奖励分支",
        "max_hit": 1,
        "recognition": "And",
        "all_of": [
            "BaseProbeHome"
        ],
        "timeout": 30000,
        "next": [
            "MissionEnterHome",
            "[JumpBack]BaseBranchError",
            "MissionProbeUnrewardable"
        ]
    },
    // 没有任务奖励
    "MissionProbeUnrewardable": {
        "desc": "[end] 没有任务奖励",
        "recognition": "And",
        "all_of": [
            "MissionProbeRewardable"
        ],
        "inverse": true
    },
    /* -------------------- 动作-进入主页 -------------------- */
    "MissionEnterHome": {
        "desc": "进入任务奖励页面",
        "recognition": "And",
        "all_of": [
            "MissionProbeTaskText",
            "MissionProbeRewardable"
        ],
        "box_index": 0,
        "target_offset": [
            0,
            -36,
            0,
            1
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "BaseErrorNext",
            "[JumpBack]MissionClickGetReward",
            "[JumpBack]BaseClickRewardTap",
            "MissionProbeEnd",
            "[JumpBack]BaseBranchError",
            "MissionEnterHome"
        ]
    },
    // 任务按钮文字
    "MissionProbeTaskText": {
        "desc": "[end] 有任务按钮文字",
        "recognition": "OCR",
        "expected": "任务",
        "roi": [
            857,
            677,
            49,
            32
        ]
    },
    // 一键领取
    "MissionClickGetReward": {
        "desc": "[jp] 点击一键领取",
        "recognition": "TemplateMatch",
        "template": "Reward/RewardLight.png",
        "method": 10001,
        "action": "Click",
        "roi": [
            992,
            69,
            215,
            84
        ],
        "post_wait_freezes": 1000
    },
    // 领取结束
    "MissionProbeEnd": {
        "desc": "[end] 领取资源结束标志",
        "recognition": "TemplateMatch",
        "template": "Reward/Dart.png",
        "method": 10001,
        "threshold": 0.8,
        "roi": [
            986,
            140,
            195,
            194
        ]
    }
