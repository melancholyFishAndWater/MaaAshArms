{
    // INFO 委派
    "TaskEntrust": {
        "desc": "委派作战任务",
        "next": [
            "[JumpBack]EntrustEnterRewardMainLine",
            "[JumpBack]EntrustCheckDaily",
            "[JumpBack]EntrustEnableDailyUpdate",
            "[JumpBack]EntrustInit",
            "EntrustEnterMainLine",
            "[JumpBack]ReturnBattleMainPage"
        ]
    },
    "EntrustCheckDaily": {
        "desc": "检测每日一次。不可重入",
        "recognition": "Custom",
        "custom_recognition": "EntrustCheckDailyReco",
        "custom_recognition_param": {
            "enable": true
        },
        "max_hit": 1
    },
    "EntrustEnableDailyUpdate": {
        "desc": "启用更新每日一次。不可重入",
        "max_hit": 1,
        "action": "Custom",
        "custom_action": "EntrustEnableDailyUpdateAct",
        "focus": {
            "Node.Action.Failed": "警告：启用更新每日一次失败"
        },
        "on_error": [
            "[JumpBack]EntrustInit",
            "EntrustEnterMainLine",
            "[JumpBack]ReturnBattleMainPage"
        ]
    },
    "EntrustInit": {
        "desc": "委派作战初始化。不可重入",
        "action": "Custom",
        "custom_action": "EntrustInitAct",
        "max_hit": 1,
        "attach": {
            // 层级：章节（"下一章"所在层）→ 大关（stage_name）→ 小关（level 匹配的数字）
            "stage_name": "结晶废墟", // 大关名
            "level": 10 // 目标小关的数字
        }
    },
    "EntrustEnterMainLine": {
        "desc": "进入主线页面",
        "recognition": "OCR",
        "expected": "主线篇章",
        "roi": [
            313,
            357,
            103,
            38
        ],
        "action": "Click",
        "next": [
            "EntrustChooseStage",
            "[JumpBack]EntrustNextChapter",
            "EntrustEnterMainLine"
        ],
        "post_wait_freezes": 3000
    },
    "EntrustChooseStage": {
        "desc": "选择目标大关",
        "recognition": "Custom",
        "custom_recognition": "EntrustChooseStageReco",
        "action": "Click",
        "next": [
            "EntrustMoveToFind"
        ],
        "post_wait_freezes": 2500
    },
    "EntrustNextChapter": {
        "desc": "下一章",
        "recognition": "OCR",
        "expected": "下一章",
        "roi": [
            1199,
            325,
            70,
            34
        ],
        "action": "Click",
        "target": [
            1246,
            277
        ],
        "max_hit": 8
    },
    "EntrustMoveToFind": {
        "desc": "移动画面直到找到目标关卡",
        "next": [
            "EntrustChooseLevel",
            "[JumpBack]MoveRight"
        ]
    },
    "EntrustChooseLevel": {
        "desc": "选择关卡",
        "recognition": "Custom",
        "custom_recognition": "EntrustChooseLevelReco",
        "target_offset": [
            -64,
            87,
            -64,
            2
        ],
        "action": "Click",
        "next": [
            "EntrustAble",
            "EntrustUnable",
            "EntrustChooseLevel"
        ],
        "post_wait_freezes": 1000
    },
    "EntrustAble": {
        "desc": "进入委派页面",
        "recognition": "TemplateMatch",
        "template": "Entrust/able.png",
        "roi": [
            841,
            571,
            239,
            133
        ],
        "action": "Click",
        "next": [
            "EntrustTouchDown",
            "EntrustAble"
        ]
    },
    // INFO 无法委派
    "EntrustUnable": {
        "desc": "无法委派",
        "recognition": "TemplateMatch",
        "template": "Entrust/unable.png",
        "action": "Click",
        "next": [
            "EntrustNow",
            "EntrustMax",
            "EntrustUnable"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "识别到无法委派，返回主页尝试领取奖励",
            "Node.NextList.Failed": "无法委派后续节点超时，未定义的错误"
        }
    },
    "EntrustNow": {
        "desc": "正在委派",
        "recognition": "OCR",
        "expected": "正在执行委派",
        "roi": [
            343,
            343,
            608,
            37
        ],
        "next": [
            "EntrustEnterRewardMainLine",
            "[JumpBack]ReturnMain"
        ],
        "post_wait_freezes": 5000
    },
    "EntrustMax": {
        "desc": "委派次数已达上限",
        "recognition": "OCR",
        "expected": "已达上限",
        "roi": [
            343,
            343,
            608,
            37
        ],
        "next": [
            "EntrustDailyUpdate"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "委托次数已达上限"
        }
    },
    // INFO 可以委派的后续
    "EntrustTouchDown": {
        "desc": "按下加号",
        "recognition": "TemplateMatch",
        "template": "Entrust/AddButton.png",
        "pre_wait_freezes": 1000,
        "action": "TouchDown",
        "target": [
            476,
            652
        ],
        "timeout": 10000,
        "next": [
            "EntrustTouchUp"
        ],
        // // "auto_up": true,
        "pressure": 1,
        "on_error": [
            "[JumpBack]EntrustTouchUp2",
            "EntrustStart"
        ]
    },
    "EntrustTouchUp2": {
        "desc": "无条件松手",
        "action": "TouchUp",
        "max_hit": 1,
        "focus": {
            "Node.Action.Succeeded": "警告，未识别到期望派遣数"
        }
    },
    "EntrustTouchUp": {
        "desc": "松开加号",
        "recognition": "Custom",
        "custom_recognition": "EntrustTouchUpReco",
        "action": "TouchUp",
        "next": [
            "EntrustStart"
        ]
    },
    "EntrustStart": {
        "desc": "开始委派",
        "recognition": "OCR",
        "expected": "出击",
        "roi": [
            1058,
            628,
            72,
            46
        ],
        "action": "Click",
        "post_wait_freezes": 500,
        "next": [
            "IsNoMetal",
            "[JumpBack]EntrustEnableReward",
            "EntrustDailyUpdate"
        ]
    },
    "EntrustDailyUpdate": {
        "desc": "更新每日一次",
        "action": "Custom",
        "custom_action": "EntrustDailyUpdateAct",
        "enabled": false
    },
    "EntrustEnableReward": {
        "desc": "启用领取功能",
        "action": "Custom",
        "custom_action": "EntrustEnableRewardAct",
        "max_hit": 1
    },
    // INFO 领取任务入口
    "TaskEntrustGetReward": {
        "desc": "领取委派奖励任务入口",
        "enabled": false,
        "timeout": 300000, // 最大委托时间
        "next": [
            "EntrustEnterRewardMainLine",
            "[JumpBack]ReturnMain"
        ]
    },
    "EntrustEnterRewardMainLine": {
        "desc": "进入领取奖励页面（主线页面）",
        "recognition": "OCR",
        "expected": "前往",
        "roi": [
            816,
            94,
            116,
            43
        ],
        "action": "Click",
        "next": [
            "EntrustClickRewardLevel",
            "EntrustEnterRewardMainLine"
        ]
    },
    "EntrustClickRewardLevel": {
        "desc": "点击可领取的关卡",
        "recognition": "OCR",
        "expected": "委派完成",
        "roi": [
            0,
            290,
            1280,
            346
        ],
        "target_offset": [
            31,
            -101,
            -49,
            1
        ],
        "action": "Click",
        "next": [
            "EntrustGetReward",
            "EntrustClickRewardLevel"
        ]
    },
    "EntrustGetReward": {
        "desc": "点击领取委派奖励",
        "recognition": "OCR",
        "expected": "领取",
        "roi": [
            917,
            593,
            353,
            108
        ],
        "action": "Click",
        "next": [
            "EntrustGetReward",
            "EntrustClickRewardLevel",
            "EntrustClickFinish",
            "[JumpBack]IsGetReward",
            "[JumpBack]ClickTap"
        ]
    },
    "EntrustClickFinish": {
        "desc": "点击完成",
        "recognition": "OCR",
        "expected": "完成",
        "roi": [
            686,
            639,
            73,
            40
        ],
        "action": "Click",
        "next": [
            "EntrustClickFinishSuccess",
            "EntrustClickFinish"
        ]
    },
    "EntrustClickFinishSuccess": {
        "desc": "点击完成后画面已变（第二帧）",
        "recognition": "And",
        "all_of": [
            "EntrustClickFinish"
        ],
        "inverse": true
    }
}