{
    /*
    INFO 委派（委托）
    
    使用任务链结构 v3.9 校验年月日 26/11/02
    使用节点命名与分类 v3.9 校验年月日 26/11/02
    */
    "TaskEntrust": {
        "desc": "委派作战任务",
        "next": [
            "[JumpBack]EntrustProbeDaily",
            "[JumpBack]EntrustInit",
            "[JumpBack]BattleEnterHome",
            "EntrustBranchStage",
            "EntrustEnterMainLine",
            "[JumpBack]BaseBranchError",
            "[JumpBack]BaseReturnHome"
        ]
    },
    /* -------------------- 子入口 -------------------- */
    // INFO 现在委派可领取
    "EntrustRewardableNow": {
        "desc": "[jp][once] 如果现在委派能领取奖励则领取",
        "max_hit": 1,
        "recognition": "Custom",
        "custom_recognition": "EntrustRewardableNowReco",
        "next": [
            "EntrustClickRewardLevel",
            "EntrustEnterRewardStage",
            "[JumpBack]BaseBranchError",
            "[JumpBack]BaseReturnHome"
        ],
        "on_error": [
            "EntrustStopRewardTimeout"
        ]
    },
    // INFO 委派将来可领取
    "EntrustRewardableLate": {
        "desc": "[jp][once] 如果已经委派且还没领取奖励 则等待直到可领取",
        "max_hit": 1,
        "recognition": "Custom",
        "custom_recognition": "EntrustRewardableLateReco",
        "timeout": 35000,
        "next": [
            "[JumpBack]EntrustProbeNow",
            "EntrustClickRewardLevel",
            "EntrustEnterRewardStage",
            "[JumpBack]BaseBranchError",
            "[JumpBack]BaseReturnHome"
        ],
        "on_error": [
            "EntrustStopRewardTimeout"
        ]
    },
    "EntrustProbeDaily": {
        "desc": "[once] 检测每日一次",
        "max_hit": 1,
        "recognition": "Custom",
        "custom_recognition": "EntrustProbeDailyReco",
        "custom_recognition_param": {
            "enable": true
        }
    },
    "EntrustProbeNow": {
        "desc": "[end] 当前画面上有正在委派的关卡",
        "recognition": "TemplateMatch",
        "template": "Entrust/EntrustNow.png",
        "roi": [
            158,
            290,
            991,
            346
        ],
        "post_delay": 3000
    },
    /* -------------------- 通用探测 -------------------- */
    "EntrustProbeStageText": {
        "desc": "[end] 有符合配置的大关名字 代表在大关内 但选中了小关就看不见了",
        "recognition": "Custom",
        "custom_recognition": "EntrustProbeStageTextReco"
    },
    "EntrustProbeMapText": {
        "desc": "[end] 有地图这个文字 实际上章节和大关页面都有 所以很少用",
        "recognition": "OCR",
        "expected": "地图",
        "roi": [
            123,
            14,
            115,
            42
        ]
    },
    "EntrustProbeEntrustDart": {
        "desc": "[end] 委派按钮暗淡",
        "recognition": "TemplateMatch",
        "template": "Entrust/Unable.png",
        "roi": [
            827,
            546,
            260,
            174
        ]
    },
    "EntrustProbeEntrustLight": {
        "desc": "[end] 委派按钮亮",
        "recognition": "TemplateMatch",
        "template": "Entrust/Able.png",
        "roi": [
            827,
            546,
            260,
            174
        ]
    },
    "EntrustProbeRewardButton": {
        "desc": "[end] 有领取按钮",
        "recognition": "OCR",
        "expected": "领取",
        "roi": [
            912,
            589,
            291,
            103
        ]
    },
    "EntrustProbeCanStart": {
        "desc": "[end] 委派次数匹配 可以委派",
        "recognition": "Custom",
        "custom_recognition": "EntrustProbeCanStartReco"
    },
    "EntrustProbeLevel": {
        "desc": "[end] 在小关页面",
        "recognition": "OCR",
        "expected": "委派作战",
        "roi": [
            73,
            223,
            62,
            162
        ]
    },
    /* -------------------- 动作-初始化 -------------------- */
    "EntrustInit": {
        "desc": "[once][jp] 委派作战初始化",
        "max_hit": 1,
        "action": "Custom",
        "custom_action": "EntrustInitAct",
        "attach": {
            // INFO 提供给vscode调试 发布版中会被覆写
            // 层级：章节（Chapter）→ 大关（stage_name）→ 小关（level）
            "stage_name": "结晶废墟", // 大关名
            "level": 10, // 目标小关的数字
            "times": 3 // 委派次数
        }
    },
    /* -------------------- 动作-进入主线 -------------------- */
    "EntrustEnterMainLine": {
        "desc": "进入主线页面",
        "recognition": "OCR",
        "expected": "主线篇章",
        "roi": [
            313,
            357,
            103,
            38
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "BaseErrorNext",
            "EntrustBranchChapter",
            "[JumpBack]BaseBranchError",
            "EntrustEnterMainLine"
        ]
    },
    /* -------------------- 分支-章节页面 -------------------- */
    "EntrustBranchChapter": {
        "desc": "在章节页面 找目标大关",
        "recognition": "OCR",
        "expected": "完成度",
        "roi": [
            38,
            529,
            82,
            35
        ],
        "next": [
            "EntrustBranchStageFreezes",
            "EntrustEnterStage",
            "[JumpBack]EntrustClickSwitchChapter",
            "[JumpBack]BaseBranchError"
        ]
    },
    // 点击切换章节
    "EntrustClickSwitchChapter": {
        "desc": "点击切换章节",
        "recognition": "Custom",
        "custom_recognition": "EntrustClickSwitchChapterReco",
        "action": "Click",
        "post_wait_freezes": 1000
    },
    // 页面未变化次数过多
    "EntrustBranchStageFreezes": {
        "desc": "[end] 在同一个页面次数过久，未识别到目标大关",
        "recognition": "And",
        "all_of": [
            "BaseProbeFreezes"
        ],
        "next": [
            "BaseTaskStopError"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "未识别到目标章节"
        }
    },
    /* -------------------- 动作-进入大关 -------------------- */
    "EntrustEnterStage": {
        "desc": "进入目标大关",
        "recognition": "Custom",
        "custom_recognition": "EntrustEnterStageReco",
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "BaseErrorNext",
            "EntrustBranchStage",
            "[JumpBack]BaseBranchError",
            "EntrustEnterStage"
        ]
    },
    /* -------------------- 分支-大关页面 -------------------- */
    // 在大关页 找目标小关
    "EntrustBranchStage": {
        "desc": "在大关页面 找目标小关",
        "recognition": "Or",
        "any_of": [
            "EntrustProbeStageText",
            "EntrustProbeLevelInfo" // INFO 防止太卡点到小关 无法识别到大关文字
        ],
        "next": [
            "BaseErrorNext",
            "EntrustChooseLevel",
            "[JumpBack]BaseBranchError",
            "[JumpBack]EntrustMover"
        ]
    },
    "EntrustProbeLevelInfo": {
        "desc": "[end] 在小关详情页面",
        "recognition": "OCR",
        "expected": "出击",
        "roi": [
            1068,
            606,
            140,
            63
        ]
    },
    // 选择目标关卡
    "EntrustChooseLevel": {
        "desc": "选择目标关卡",
        "recognition": "Custom",
        "custom_recognition": "EntrustChooseLevelReco",
        "target_offset": [
            -64,
            87,
            -64,
            2
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "BaseErrorNext",
            "EntrustBranchLevelInfo",
            "[JumpBack]BaseBranchError",
            "EntrustChooseLevel"
        ]
    },
    // 滑动直到找到目标关卡
    "EntrustMover": {
        "desc": "[jp] 识别并移动直到找到关卡",
        "recognition": "Custom",
        "custom_recognition": "EntrustMoverReco",
        "action": "Custom",
        "custom_action": "EntrustMoverAct"
    },
    /* -------------------- 分支-小关详情 -------------------- */
    // 到小关详情 委派或领奖
    "EntrustBranchLevelInfo": {
        "desc": "在小关详情页面 委派或领奖",
        "recognition": "Or",
        "any_of": [
            "EntrustProbeEntrustLight",
            "EntrustProbeEntrustDart",
            "EntrustProbeRewardButton"
        ],
        "next": [
            "EntrustClickLight",
            "EntrustClickDart",
            "EntrustBranchReward",
            "[JumpBack]BaseBranchError"
        ]
    },
    "EntrustBranchReward": {
        "desc": "领取奖励",
        "recognition": "And",
        "all_of": [
            "EntrustProbeRewardButton"
        ],
        "next": [
            "BaseErrorNext",
            "[JumpBack]EntrustClickRewardButton",
            "EntrustChooseLevel", // INFO 领奖大循环 理论不会重复触发
            "[JumpBack]BaseBranchError"
        ]
    },
    /* -------------------- 动作-委派暗淡 -------------------- */
    "EntrustClickDart": {
        "desc": "点击暗淡的按钮 分析原因",
        "recognition": "And",
        "all_of": [
            "EntrustProbeEntrustDart"
        ],
        "action": "Click",
        "rate_limit": 0,
        "next": [
            "BaseErrorNext",
            "EntrustBranchMax",
            "EntrustBranchDelegating",
            "EntrustClickDart"
        ],
        "focus": {
            "Node.PipelineNode.Failed": "未定义的委派错误"
        }
    },
    // 委派次数已达上限
    "EntrustBranchMax": {
        "desc": "委派次数耗尽",
        "recognition": "OCR",
        "expected": "已达上限",
        "roi": [
            343,
            343,
            608,
            37
        ],
        "next": [
            "EntrustDailyUpdate"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "今日委托次数已达上限 任务结束"
        }
    },
    // 正在委派
    "EntrustBranchDelegating": {
        "desc": "[once] 委派中",
        "max_hit": 1,
        "recognition": "OCR",
        "expected": "正在执行委派",
        "roi": [
            343,
            343,
            608,
            37
        ],
        "next": [
            "[JumpBack]EntrustDelegatingReward",
            "EntrustBranchStage", // 大循环
            "[JumpBack]BattleEnterHome",
            "EntrustEnterMainLine", // 大循环
            "[JumpBack]BaseReturnHome"
        ]
    },
    // 领取奖励
    "EntrustDelegatingReward": {
        "desc": "[jp][once] 委派中-领取奖励",
        "max_hit": 1,
        "next": [
            "[JumpBack]EntrustProbeNow",
            "EntrustClickRewardLevel",
            "EntrustEnterRewardStage",
            "[JumpBack]BaseBranchError",
            "[JumpBack]BaseReturnHome"
        ]
    },
    /* -------------------- 动作-委派 -------------------- */
    "EntrustClickLight": {
        "desc": "点击亮的委派按钮",
        "recognition": "And",
        "all_of": [
            "EntrustProbeEntrustLight"
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "BaseErrorNext",
            "EntrustBranchTouchMax",
            "EntrustBranchTouchPart",
            "EntrustClickLight"
        ]
    },
    /* -------------------- 分支-所有次数 -------------------- */
    "EntrustBranchTouchMax": {
        "desc": "条件委派全部次数",
        "recognition": "And",
        "all_of": [
            "EntrustProbeLevel",
            "EntrustProbeTouchMax"
        ],
        "next": [
            "EntrustTouchDown"
        ]
    },
    "EntrustProbeTouchMax": {
        "desc": "[end] 最大委派次数",
        "recognition": "Custom",
        "custom_recognition": "EntrustProbeTouchMaxReco"
    },
    // 按住加号
    "EntrustTouchDown": {
        "desc": "按下加号",
        "recognition": "TemplateMatch",
        "template": "Entrust/AddButton.png",
        "pre_wait_freezes": 1000,
        "action": "TouchDown",
        "target": [
            476,
            652
        ],
        "timeout": 12000, // INFO 按下后增加速度会逐渐加速
        "next": [
            "EntrustTouchUp"
        ],
        // // "auto_up": true,
        "pressure": 1,
        "on_error": [
            "EntrustTouchUp2"
        ]
    },
    // 松开加号
    "EntrustTouchUp": {
        "desc": "松开加号",
        "recognition": "And",
        "all_of": [
            "EntrustProbeCanStart"
        ],
        "action": "TouchUp",
        "next": [
            "EntrustStart"
        ]
    },
    // 无条件松手
    "EntrustTouchUp2": {
        "desc": "无条件松手 然后开始委派",
        "action": "TouchUp",
        "next": [
            "EntrustStart"
        ],
        "focus": {
            "Node.Action.Succeeded": "警告，未识别到期望派遣数"
        }
    },
    /* -------------------- 分支-部分次数 -------------------- */
    "EntrustBranchTouchPart": {
        "desc": "点到指定委派次数",
        "recognition": "And",
        "all_of": [
            "EntrustProbeLevel"
        ],
        "next": [
            "EntrustBranchTouchPartSuccess",
            "[JumpBack]EntrustClickPlus",
            "[JumpBack]EntrustClickMinus",
            "[JumpBack]BaseBranchError"
        ]
    },
    // 达到目标次数
    "EntrustBranchTouchPartSuccess": {
        "desc": "达成数量 开始委派",
        "recognition": "And",
        "all_of": [
            "EntrustProbeCanStart"
        ],
        "next": [
            "EntrustStart"
        ]
    },
    // 点击加号
    "EntrustClickPlus": {
        "desc": "[jp] 点击加号",
        "recognition": "Custom",
        "custom_recognition": "EntrustClickPlusReco",
        "action": "Click",
        "post_wait_freezes": 1000
    },
    // 点击减号
    "EntrustClickMinus": {
        "desc": "[jp] 点击减号",
        "recognition": "Custom",
        "custom_recognition": "EntrustClickMinusReco",
        "action": "Click",
        "post_wait_freezes": 1000
    },
    /* -------------------- 动作-开始委派 -------------------- */
    "EntrustStart": {
        "desc": "开始委派",
        "recognition": "OCR",
        "expected": "出击",
        "roi": [
            1058,
            628,
            72,
            46
        ],
        "action": "Click",
        "rate_limit": 0,
        "next": [
            "BaseErrorNext",
            "BaseStopNoMetal",
            "EntrustStartSuccess",
            "EntrustStart"
        ],
        "focus": {
            "Node.PipelineNode.Failed": "判断委派状态失败"
        }
    },
    // 委派成功
    "EntrustStartSuccess": {
        "desc": "委派成功",
        "recognition": "Or",
        "any_of": [
            "EntrustProbeStageText",
            "EntrustProbeMapText"
        ],
        "action": "Custom",
        "custom_action": "EntrustStartSuccessAct",
        "next": [
            "EntrustDailyUpdate"
        ]
    },
    // 更新每日一次
    "EntrustDailyUpdate": {
        "desc": "[end] 更新每日一次",
        "action": "Custom",
        "custom_action": "EntrustDailyUpdateAct"
    }
}