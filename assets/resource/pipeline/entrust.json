{
    /*
    INFO 委派（委托）
    
    使用任务链结构 v1.6 校验年月日 26/10/17
    使用节点命名与分类 v1.8 校验年月日 26/10/17
    */
    "TaskEntrust": {
        "desc": "委派作战任务",
        "next": [
            "[JumpBack]EntrustProbeDaily",
            "[JumpBack]EntrustInit",
            "EntrustClickLight",
            "[JumpBack]EntrustClickDart",
            "[JumpBack]EntrustLoopGetReward",
            "[JumpBack]BaseBranchError",
            "[JumpBack]EntrustEnsureLevelInfo"
        ]
    },
    // INFO 委派领取任务
    "TaskEntrustGetReward": {
        "desc": "[jp][once] 如果本次任务链中 委派能领取奖励则领取",
        "max_hit": 1,
        "recognition": "Custom",
        "custom_recognition": "TaskEntrustGetRewardReco",
        "next": [
            "EntrustLoopGetReward",
            "[JumpBack]BaseBranchError",
            "[JumpBack]EntrustEnsureRewardInfo"
        ]
    },
    // INFO 训练所专用委派领取任务
    "TaskEntrustTrainingGetReward": {
        "desc": "[jp][once] 训练所任务专用领取奖励",
        "max_hit": 1,
        "recognition": "Custom",
        "custom_recognition": "TaskEntrustTrainingGetRewardReco",
        "next": [
            "EntrustLoopGetReward",
            "[JumpBack]BaseBranchError",
            "[JumpBack]EntrustEnsureRewardInfo"
        ]
    },
    "EntrustInit": {
        "desc": "[once][jp] 委派作战初始化",
        "max_hit": 1,
        "action": "Custom",
        "custom_action": "EntrustInitAct",
        "attach": {
            // INFO 提供给vscode调试 发布版中会被覆写
            // 层级：章节（Chapter）→ 大关（stage_name）→ 小关（level）
            "stage_name": "结晶废墟", // 大关名
            "level": 10, // 目标小关的数字
            "times": 3 // 委派次数
        }
    },
    /* -------------------- 探测 -------------------- */
    "EntrustProbeDaily": {
        "desc": "[once] 检测每日一次",
        "max_hit": 1,
        "recognition": "Custom",
        "custom_recognition": "EntrustProbeDailyReco",
        "custom_recognition_param": {
            "enable": true
        }
    },
    "EntrustProbeChapter": {
        "desc": "[end] 在章节页面",
        "recognition": "OCR",
        "expected": "完成度",
        "roi": [
            38,
            529,
            82,
            35
        ]
    },
    "EntrustProbeStageName": {
        "desc": "[end] 有符合配置的大关名字 代表在大关内 但选中了小关就看不见了",
        "recognition": "Custom",
        "custom_recognition": "EntrustProbeStageNameReco"
    },
    "EntrustProbeMapName": {
        "desc": "[end] 有地图这个文字 实际上章节和大关页面都有 所以很少用",
        "recognition": "OCR",
        "expected": "地图",
        "roi": [
            123,
            14,
            115,
            42
        ]
    },
    "EntrustProbeEntrust": {
        "desc": "[end] 有委派按钮",
        "recognition": "Or",
        "any_of": [
            "EntrustProbeEntrustLight",
            "EntrustProbeEntrustDart"
        ]
    },
    "EntrustProbeEntrustDart": {
        "desc": "[end] 委派按钮暗淡",
        "recognition": "TemplateMatch",
        "template": "Entrust/unable.png",
        "roi": [
            827,
            546,
            260,
            174
        ]
    },
    "EntrustProbeEntrustLight": {
        "desc": "[end] 委派按钮亮",
        "recognition": "TemplateMatch",
        "template": "Entrust/able.png",
        "roi": [
            827,
            546,
            260,
            174
        ]
    },
    "EntrustProbeEntrustNow": {
        "desc": "[end] 正在委派 识别文字",
        "recognition": "OCR",
        "expected": "正在执行委派",
        "roi": [
            343,
            343,
            608,
            37
        ]
    },
    "EntrustProbeEntrustMax": {
        "desc": "[end] 委派次数已达上限",
        "recognition": "OCR",
        "expected": "已达上限",
        "roi": [
            343,
            343,
            608,
            37
        ]
    },
    "EntrustProbeRewardButton": {
        "desc": "[end] 有领取按钮",
        "recognition": "OCR",
        "expected": "领取",
        "roi": [
            912,
            589,
            291,
            103
        ]
    },
    "EntrustProbeRewardText": {
        "desc": "[end] 有委派完成文字",
        "recognition": "OCR",
        "expected": "委派完成",
        "roi": [
            0,
            290,
            1280,
            346
        ]
    },
    "EntrustProbeLevelInfo": {
        "desc": "[end] 在小关详情页面",
        "recognition": "Or",
        "any_of": [
            "EntrustProbeEntrust",
            "EntrustProbeRewardButton"
        ]
    },
    "EntrustProbeCanStart": {
        "desc": "[end] 委派次数匹配 可以委派",
        "recognition": "Custom",
        "custom_recognition": "EntrustProbeCanStartReco"
    },
    "EntrustProbeChaapterFinsh": {
        "desc": "[end] 当前页面所有章节已完成",
        "recognition": "OCR",
        "expected": "完成度.*?(\\d)/\\1",
        "roi": [
            45,
            527,
            125,
            40
        ]
    },
    /* -------------------- 就位 -------------------- */
    // INFO 章节
    "EntrustEnsureChapter": {
        "desc": "[jp] 确保在章节页面",
        "recognition": "And",
        "all_of": [
            "EntrustProbeChapter"
        ],
        "inverse": true,
        "timeout": 30000,
        "focus": {
            "Node.PipelineNode.Failed": "未找到章节页面，检查是否停留在主线页面"
        },
        "next": [
            "EntrustProbeChapter",
            "[JumpBack]BaseBranchError",
            "[JumpBack]EntrustEnterMainLine",
            "[JumpBack]BattleEnsureHome"
        ]
    },
    "EntrustEnterMainLine": {
        "desc": "[jp] 进入主线页面",
        "recognition": "OCR",
        "expected": "主线篇章",
        "roi": [
            313,
            357,
            103,
            38
        ],
        "action": "Click",
        "post_wait_freezes": 1000
    },
    // INFO 大关
    "EntrustEnsureStage": {
        "desc": "[jp] 确保在大关页面",
        "recognition": "And",
        "all_of": [
            "EntrustProbeStageName"
        ],
        "inverse": true,
        "timeout": 30000,
        "next": [
            "EntrustProbeStageName",
            "[JumpBack]BaseBranchError",
            "[JumpBack]EntrustEnterStage",
            "[JumpBack]EntrustClickNextChapter",
            "[JumpBack]EntrustEnsureChapter"
        ],
        "focus": {
            "Node.PipelineNode.Failed": "寻找关卡失败 可能关卡未解锁"
        }
    },
    "EntrustEnterStage": {
        "desc": "[jp] 进入目标大关",
        "recognition": "Custom",
        "custom_recognition": "EntrustEnterStageReco",
        "action": "Click",
        "post_wait_freezes": 1000
    },
    "EntrustClickNextChapter": {
        "desc": "[max] 点击下一章区域",
        "recognition": "And",
        "all_of": [
            "EntrustProbeChaapterFinsh"
        ],
        "target": [
            1247,
            280
        ],
        "action": "Click"
    },
    // TODO 关卡未解锁
    // INFO 委派详情页面
    "EntrustEnsureLevelInfo": {
        "desc": "[jp] 确保在小关详情页面",
        "recognition": "And",
        "all_of": [
            "EntrustProbeLevelInfo"
        ],
        "inverse": true,
        "timeout": 45000, // INFO 防止电脑太卡
        "next": [
            "EntrustProbeLevelInfo",
            "[JumpBack]BaseBranchError",
            "[JumpBack]EntrustChooseLevel",
            "[JumpBack]EntrustMover",
            "[JumpBack]EntrustEnsureStage"
        ],
        "focus": {
            "Node.PipelineNode.Failed": "寻找小关卡失败 可能关卡未解锁"
        }
    },
    "EntrustChooseLevel": {
        "desc": "[jp] 选择关卡",
        "recognition": "And",
        "all_of": [
            "EntrustProbeStageName",
            {
                "recognition": "Custom",
                "custom_recognition": "EntrustChooseLevelReco"
            }
        ],
        "box_index": 1,
        "target_offset": [
            -64,
            87,
            -64,
            2
        ],
        "action": "Click",
        "post_wait_freezes": 1000
    },
    "EntrustMover": {
        "desc": "[jp] 识别并移动直到找到关卡",
        "recognition": "And",
        "all_of": [
            "EntrustProbeStageName",
            {
                "recognition": "Custom",
                "custom_recognition": "EntrustMoverReco"
            }
        ],
        "action": "Custom",
        "custom_action": "EntrustMoverAct"
    },
    /* -------------------- 工作 -------------------- */
    // INFO 分支-委派按钮亮
    "EntrustClickLight": {
        "desc": "[max] 点击亮的委派按钮",
        "max_hit": 10,
        "recognition": "And",
        "all_of": [
            "EntrustProbeEntrustLight"
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "timeout": 60000,
        "next": [
            "EntrustBranchTouchMax",
            "EntrustBranchClickTimesSuccess",
            "[JumpBack]EntrustClickPlus",
            "[JumpBack]EntrustClickMinus",
            "EntrustClickLight"
        ]
    },
    // INFO 委派完所有次数
    "EntrustBranchTouchMax": {
        "desc": "条件委派全部次数",
        "recognition": "Custom",
        "custom_recognition": "EntrustBranchTouchMaxReco",
        "next": [
            "EntrustTouchDown"
        ]
    },
    "EntrustTouchDown": {
        "desc": "按下加号",
        "recognition": "TemplateMatch",
        "template": "Entrust/AddButton.png",
        "pre_wait_freezes": 1000,
        "action": "TouchDown",
        "target": [
            476,
            652
        ],
        "timeout": 12000, // INFO 按下后增加速度会逐渐加速
        "next": [
            "EntrustTouchUp"
        ],
        // // "auto_up": true,
        "pressure": 1,
        "on_error": [
            "[JumpBack]EntrustTouchUp2",
            "EntrustStart"
        ]
    },
    "EntrustTouchUp": {
        "desc": "松开加号",
        "recognition": "And",
        "all_of": [
            "EntrustProbeCanStart"
        ],
        "action": "TouchUp",
        "next": [
            "EntrustStart"
        ]
    },
    "EntrustTouchUp2": {
        "desc": "[once][jp] 无条件松手",
        "max_hit": 1,
        "action": "TouchUp",
        "focus": {
            "Node.Action.Succeeded": "警告，未识别到期望派遣数"
        }
    },
    // INFO 委派部分次数
    "EntrustBranchClickTimesSuccess": {
        "desc": "达成数量 开始委派",
        "recognition": "And",
        "all_of": [
            "EntrustProbeCanStart"
        ],
        "next": [
            "EntrustStart"
        ]
    },
    "EntrustClickPlus": {
        "desc": "[jp] 点击加号",
        "recognition": "Custom",
        "custom_recognition": "EntrustClickPlusReco",
        "action": "Click",
        "post_wait_freezes": 1000
    },
    "EntrustClickMinus": {
        "desc": "[jp] 点击减号",
        "recognition": "Custom",
        "custom_recognition": "EntrustClickMinusReco",
        "action": "Click",
        "post_wait_freezes": 1000
    },
    // INFO 委派开始
    "EntrustStart": {
        "desc": "[max] 开始委派",
        "max_hit": 10,
        "recognition": "OCR",
        "expected": "出击",
        "roi": [
            1058,
            628,
            72,
            46
        ],
        "action": "Click",
        "post_wait_freezes": 500,
        "next": [
            "IsNoMetal",
            "EntrustStartSuccess",
            "EntrustStart"
        ],
        "focus": {
            "Node.PipelineNode.Failed": "判断委派状态失败"
        }
    },
    "EntrustStartSuccess": {
        "desc": "委派成功",
        "recognition": "Or",
        "any_of": [
            "EntrustProbeStageName",
            "EntrustProbeMapName"
        ],
        "action": "Custom",
        "custom_action": "EntrustStartSuccessAct",
        "next": [
            "EntrustDailyUpdate"
        ]
    },
    // INFO 分支-委派按钮暗淡
    "EntrustClickDart": {
        "desc": "[max] 点击暗淡的按钮 分析原因",
        "max_hit": 10,
        "recognition": "And",
        "all_of": [
            "EntrustProbeEntrustDart"
        ],
        "action": "Click",
        "next": [
            "EntrustBranchMax",
            "EntrustBranchDelegating",
            "EntrustClickDart"
        ],
        "focus": {
            "Node.PipelineNode.Failed": "未定义的委派错误"
        }
    },
    "EntrustBranchMax": {
        "desc": "委派次数耗尽",
        "recognition": "And",
        "all_of": [
            "EntrustProbeEntrustMax"
        ],
        "next": [
            "EntrustDailyUpdate"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "今日委托次数已达上限 任务结束"
        }
    },
    "EntrustBranchDelegating": {
        "desc": "委派中",
        "recognition": "And",
        "all_of": [
            "EntrustProbeEntrustNow"
        ],
        "next": [
            "EntrustLoopGetReward",
            "[JumpBack]BaseBranchError",
            "[JumpBack]EntrustEnsureRewardInfo"
        ]
    },
    "EntrustDailyUpdate": {
        "desc": "[end] 更新每日一次 结束任务",
        "action": "Custom",
        "custom_action": "EntrustDailyUpdateAct",
        "next": [
            "TaskStop"
        ]
    }
}