            "Node.Action.Succeeded": "合金不足，任务结束"
        }
    },
    "MaintenanceProbeAllBusy": {
        "desc": "[end] 全部忙碌 任务结束标志 需要确保在Home",
        "recognition": "Or",
        "any_of": [
            "MaintenanceProbeAble",
            "MaintenanceProbeDone"
        ],
        "inverse": true
    },
    /* -------------------- 就位 -------------------- */
    // INFO 主页面
    "MaintenanceEnsureHome": {
        "desc": "[jp] 确保在维修会主页",
        "recognition": "And",
        "all_of": [
            "MaintenanceProbeHome"
        ],
        "inverse": true,
        "rate_limit": 2000,
        "timeout": 30000,
        "next": [
            "MaintenanceProbeHome",
            "[JumpBack]BaseBranchError",
            "[JumpBack]MaintenanceEnterHome",
            "[JumpBack]ReturnMain"
        ]
    },
    "MaintenanceEnterHome": {
        "desc": "[jp] 进入维修会",
        "recognition": "OCR",
