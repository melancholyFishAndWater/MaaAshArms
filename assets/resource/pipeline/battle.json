    // INFO 通用作战 胜利
    "BattleLoopWin": {
        "desc": "[Loop] 通用作战胜利",
        "recognition": "Or",
        "any_of": [
            "BattleProbeWin",
            "BaseProbeReward"
        ],
        "timeout": 30000,
        "next": [
            // INFO 单次战斗不需要点击确认
            "BattleProbeWinEnd",
            "[JumpBack]BattleClickFinish",
            "[JumpBack]BattleBranchClickTap",
            "[JumpBack]BaseBranchError"
        ],
        "focus": {
            // INFO 失败难以回退 交由用户处理
