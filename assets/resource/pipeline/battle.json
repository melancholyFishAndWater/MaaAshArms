    /* -------------------- 分支-战斗中 -------------------- */
    // INFO 战斗
    "BattleBranchBattle": {
        "desc": "等待战斗直到结束",
        "recognition": "Or",
        "any_of": [
            "BattleProbeTips",
            "BattleProbeLoading",
            "BattleProbeNow",
            "BattleProbeWin"
        ],
        "timeout": 45000,
        "next": [
            "[JumpBack]BattleProbeNow",
            "[JumpBack]BattleProbeLoading",
            "BattleClickWinTap",
            "[JumpBack]BaseBranchError"
        ],
        "focus": {
            // INFO 失败难以回退 交由用户处理
            "Node.PipelineNode.Failed": {
                "content": "等待战斗结束失败",
                "display": [
                    "log",
                    "notification",
                    "modal"
                ]
            }
        }
    },
    /* -------------------- 分支-战斗胜利 -------------------- */
    // INFO 通用作战 胜利
    "BattleClickWinTap": {
        "desc": "胜利-点击Tap",
        "recognition": "Or",
        "any_of": [
            "BattleProbeWin",
            "BaseProbeReward"
        ],
        "action": "Click",
        "target": [
            640,
            620
        ],
        "post_wait_freezes": 500,
        "next": [
            "[JumpBack]BattleClickFinish", // INFO 训练所无完成按钮 因此使用jp使其通用
            "[JumpBack]BattleBranchClickTap",
            "BattleProbeWinEnd",
            // INFO 单次战斗不需要点击确认
            "[JumpBack]BaseBranchError"
        ],
        "focus": {
            // INFO 失败难以回退 交由用户处理
            "Node.Recognition.Starting": "战斗胜利",
            "Node.PipelineNode.Failed": {
                "content": "领取战斗奖励失败",
                "display": [
                    "log",
                    "notification",
                    "modal"
                ]
            }
        }
    },
