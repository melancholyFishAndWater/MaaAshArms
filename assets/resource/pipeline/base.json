{
    /*
    INFO 通用节点：探测 / 分支 / 移动 / 点击 / 就位 / 收尾，各任务共用

    使用任务链结构 v3.0 校验年月日 26/10/28
    使用节点命名与分类 v3.0 校验年月日 26/10/28
    */
    /* -------------------- 探测 -------------------- */
    "BaseProbeHome": {
        "desc": "[end] 在游戏主页",
        "recognition": "OCR",
        "expected": "出击作战",
        "roi": [
            805,
            288,
            460,
            111
        ]
    },
    "BaseProbeHelpButton": {
        "desc": "[end] 有问号按钮",
        "recognition": "TemplateMatch",
        "template": "Base/HelpButton.png",
        "roi": [
            315,
            0,
            143,
            106
        ]
    },
    "BaseProbeReward": {
        "desc": "[end] 在获得一览",
        "recognition": "OCR",
        "expected": "获得一览",
        "roi": [
            525,
            154,
            174,
            53
        ]
    },
    "BaseProbeNoReward": {
        "desc": "[end] 不在获得一览",
        "recognition": "And",
        "all_of": [
            "BaseProbeReward"
        ],
        "inverse": true
    },
    "BaseProbeConfirm": {
        "desc": "[end] 有确认按钮",
        "recognition": "OCR",
        "expected": "确认",
        "roi": [
            320,
            148,
            636,
            423
        ]
    },
    "BaseProbeFreezes": {
        "desc": "[end] 若画面连续k次冻结则识别成功 注意覆写roi",
        "recognition": "Custom",
        "custom_recognition": "BaseProbeFreezesReco",
        "rate_limit": 1000,
        "roi": [
            0,
            0,
            1280,
            720
        ],
        "custom_recognition_param": {
            "from_": "unknow", // 如果要一个任务链中不同节点复用 填写父节点名
            "threshold": 0.99, // 阈值
            "k": 3 // 连续不变次数 太低可能移动卡顿也识别成功了
        }
    },
    "BaseProbeBlackPage": {
        "desc": "[end] 在纯黑页面",
        "recognition": "ColorMatch",
        "lower": [
            0,
            0,
            0
        ],
        "upper": [
            10,
            10,
            10
        ],
        "count": 250000,
        "roi": [
            248,
            124,
            837,
            375
        ],
        "post_wait_freezes": 3000
    },
    /* -------------------- 分支 -------------------- */
    // INFO 错误弹窗
    "BaseBranchError": {
        "desc": "捕获任何确认按钮 点击确认并输出日志 需要注意不要和任务冲突",
        "recognition": "And",
        "all_of": [
            "BaseProbeConfirm"
        ],
        "next": [
            "BaseStopServerMaintenance",
            "BaseClickErrorConfirm"
        ]
    },
    "BaseClickErrorConfirm": {
        "desc": "[end] 点击确认按钮 并输出日志",
        "recognition": "Custom",
        "custom_recognition": "BaseClickErrorConfirmReco",
        "target": "BaseBranchError",
        "action": "Click",
        "post_wait_freezes": 1000
    },
    "BaseBranchNetworkError": {
        "desc": "网络错误弹窗 点击确认继续",
        "recognition": "OCR",
        "expected": "通信异常",
        "roi": [
            373,
            227,
            192,
            70
        ],
        "next": [
            "BaseClickConfirm"
        ]
    },
    /* -------------------- 动作-移动 -------------------- */
    // INFO 移动系列 起点是物品的话无法滑动，详见 TrainMoveToBottom
    "BaseMoveDown": {
        "desc": "通用下滑",
        "action": "Swipe",
        "begin": [
            600,
            300
        ],
        "end": [
            600,
            500
        ],
        "end_hold": 300,
        "post_wait_freezes": 200
    },
    "BaseMoveUp": {
        "desc": "通用上滑",
        "action": "Swipe",
        "begin": [
            600,
            500
        ],
        "end": [
            600,
            300
        ],
        "end_hold": 300,
        "post_wait_freezes": 200
    },
    "BaseMoveLeft": {
        "desc": "通用左滑",
        "action": "Swipe",
        "begin": [
            640,
            360
        ],
        "end": [
            440,
            360
        ],
        "end_hold": 200,
        "post_wait_freezes": 200
    },
    "BaseMoveRight": {
        "desc": "通用右滑",
        "action": "Swipe",
        "begin": [
            640,
            360
        ],
        "end": [
            840,
            360
        ],
        "end_hold": 200,
        "post_wait_freezes": 200
    },
    "BaseMoveUpDown": {
        "desc": "上滑动x次 下滑动x次",
        "recognition": "Custom",
        "custom_recognition": "BaseMoveUpDownReco",
        "custom_recognition_param": {
            "from_": "unknow", // 一个任务链存在不同节点调用时需要修改 父节点 可以为空
            "x": "10"
        },
        "action": "Custom",
        "custom_action": "BaseMoveUpDownAct"
    },
    /* -------------------- 动作-点击 -------------------- */
    "BaseClickConfirm": {
        "desc": "通用点击确认",
        "recognition": "And",
        "all_of": [
            "BaseProbeConfirm"
        ],
        "action": "Click",
        "post_wait_freezes": 500
    },
    "BaseClickCancel": {
        "desc": "通用点击取消",
        "recognition": "OCR",
        "expected": "取消",
        "roi": [
            340,
            168,
            596,
            383
        ],
        "action": "Click",
        "post_wait_freezes": 500
    },
    "BaseClick": {
        "desc": "点击屏幕中心",
        "action": "Click",
        "target": [
            640,
            360
        ],
        "post_wait_freezes": 200
    },
    "BaseClickUpperRight": {
        "desc": "点击右上",
        "target": [
            -1,
            0
        ],
        "action": "Click",
        "post_wait_freezes": 500
    },
    "BaseClickTapBox": {
        "desc": "点击tap区域",
        "action": "Click",
        "target": [
            640,
            620
        ],
        "post_wait_freezes": 500
    },
    // INFO 点击获得一览Tap
    "BaseClickRewardTap": {
        "desc": "点击获得一览Tap",
        "recognition": "And",
        "all_of": [
            "BaseProbeReward"
        ],
        "target": [
            640,
            620
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "[JumpBack]BaseBranchError",
            "BaseProbeNoReward",
            "[JumpBack]BaseClickTapBox"
        ]
    },
    "BaseClickBackButton": {
        "desc": "点击返回按钮",
        "recognition": "TemplateMatch",
        "template": [
            "StartUp/BackButton.png"
        ],
        "roi": [
            0,
            0,
            154,
            130
        ],
        "action": "Click",
        "post_wait_freezes": 1000
    },
    "BaseClickHomeButton": {
        "desc": "点击回主页按钮",
        "recognition": "TemplateMatch",
        "template": [
            "StartUp/HomeButton.png"
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "roi": [
            1140,
            0,
            140,
            130
        ]
    },
    /* -------------------- 就位 -------------------- */
    "BaseReturnHome": {
        "desc": "确保在主页面",
        "recognition": "And",
        "all_of": [
            "BaseProbeHome"
        ],
        "inverse": true,
        "timeout": 30000,
        "next": [
            "BaseProbeHome",
            "[JumpBack]BaseClickHomeButton",
            "[JumpBack]BaseClickBackButton",
            "[JumpBack]BaseClickUpperRight"
        ],
        "focus": {
            "Node.PipelineNode.Failed": {
                "content": "严重错误 返回游戏主页面失败 task_id: {task_id}",
                "display": [
                    "log",
                    "notification",
                    "modal"
                ]
            }
        }
    },
    /* -------------------- 收尾 -------------------- */
    "BaseStopNoMetal": {
        "desc": "[end] 合金不足 任务结束",
        "recognition": "OCR",
        "expected": "资源不足",
        "roi": [
            356,
            344,
            617,
            34
        ],
        "action": "StopTask",
        "focus": {
            "Node.Action.Succeeded": "合金不足，任务结束"
        }
    },
    "BaseStopServerMaintenance": {
        "desc": "[end] 游戏维护中 任务结束",
        "recognition": "OCR",
        "expected": [
            "维护中",
            "维护时间"
        ],
        "roi": [
            320,
            148,
            636,
            423
        ],
        "action": "StopTask",
        "focus": {
            "Node.Action.Starting": {
                "content": "服务器维护，任务结束",
                "display": "modal"
            }
        }
    },
    "BaseTaskStop": {
        "desc": "无条件结束任务",
        "action": "StopTask"
    },
    "BaseTaskStopError": {
        "desc": "无条件结束任务并报错",
        "action": "Custom",
        "custom_action": "BaseTaskStopErrorAct"
    },
    // INFO 兜底节点
    "BaseErrorNext": {
        "desc": "[end] 当同一个next中连续识别超过10次后 直接报错并结束任务",
        "recognition": "Custom",
        "custom_recognition": "BaseErrorNextReco",
        "rate_limit": 1000,
        "next": [
            "BaseTaskStopError"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "next异常 结束任务"
        }
    }
}