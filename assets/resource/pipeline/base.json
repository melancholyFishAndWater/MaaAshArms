    "InServerMaintenance": {
        "desc": "游戏维护中",
        "recognition": "OCR",
        "expected": ".+维护中.+",
        "roi": [
            395,
            162,
            473,
            211
        ],
        "action": "StopTask",
        "focus": {
            "Node.Action.Starting": {
                "content": "服务器维护，任务结束",
                "display": "modal"
            }
        }
    },
    "TaskStop": {
        "desc": "无条件结束任务",
        "action": "StopTask"
    },
    "IsFreezes": {
        "desc": "判断画面是否冻结 注意覆写roi",
        "recognition": "Custom",
        "custom_recognition": "IsFreezesReco",
        "roi": [
            0,
            0,
            0,
            0
        ],
        "custom_recognition_param": {
            "from_": "unknow", // 如果要一个任务链中不同节点复用 填写父节点名
            "threshold": 0.99, // 阈值
            "k": 3 // 连续不变次数 太低可能移动卡顿也识别成功了
        }
    }
