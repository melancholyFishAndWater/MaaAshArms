    /* -------------------- 工作 -------------------- */
    // INFO 错误弹窗
    "BaseBranchError": {
        "desc": "[jp] 捕获任何确认按钮 点击确认并输出日志 需要注意不要和任务冲突",
        "recognition": "And",
        "all_of": [
            "BaseProbeConfirm"
        ],
        "next": [
            "BaseBranchSeverClose",
            "BaseBranchErrorConfirm"
        ]
    },
    "BaseBranchSeverClose": {
        "desc": "[end] 游戏内服务器维护弹窗 任务结束",
        "recognition": "OCR",
        "expected": [
            "维护中",
            "维护时间"
        ],
        "roi": [
            320,
            148,
            636,
            423
        ],
        "action": "StopTask",
        "focus": {
            "Node.Recognition.Succeeded": {
                "content": "游戏维护 任务结束",
                "display": [
                    "log",
                    "notification",
                    "modal"
                ]
            }
        }
    },
    "BaseBranchErrorConfirm": {
        "desc": "[end] 点击确认按钮 并输出日志",
