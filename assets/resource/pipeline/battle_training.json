{
    /*
    INFO 训练所任务

    使用任务链结构 v4.0 校验年月日 26/11/06
    使用节点命名与分类 v3.3 校验年月日 26/11/06
    */
    // INFO 任务入口
    "TaskTraining": {
        "desc": "训练所任务",
        "next": [
            "[JumpBack]TrainingProbeDaily",
            "[JumpBack]EntrustRewardableLate",
            "[JumpBack]TrainingInit",
            // INFO 遍历候选位置
            "TrainingBranchHome",
            "TrainingEnterHome",
            "TrainingEnterBattleHome",
            // INFO 错误捕获
            "[JumpBack]BaseBranchError",
            "[JumpBack]BaseReturnHome"
        ]
    },
    "TrainingProbeDaily": {
        "desc": "[once][jp] 检测每日一次",
        "max_hit": 1,
        "recognition": "Custom",
        "custom_recognition": "TaskTrainingReco",
        "custom_recognition_param": {
            "enable": true // 每日一次开关 覆写关闭
        }
    },
    // INFO 读取关卡选项
    "TrainingInit": {
        "desc": "[once][jp] 训练所初始化",
        "max_hit": 1,
        // INFO 调试默认值
        "attach": {
            "战斗演习": "不进行",
            "狩猎行动": "六",
            "拓展训练": "六",
            "资源筹备": "六"
        },
        "action": "Custom",
        "custom_action": "TrainingInitAct"
    },
    /* -------------------- 通用探测 -------------------- */
    "TrainingProbeHomeName": {
        "desc": "[end] 有训练所文字",
        "recognition": "OCR",
        "expected": "训练所",
        "roi": [
            109,
            13,
            208,
            49
        ]
    },
    /* -------------------- 动作-进入出击主页 -------------------- */
    "TrainingEnterBattleHome": {
        "desc": "进入出击页面",
        "recognition": "OCR",
        "expected": "出击作战",
        "roi": [
            805,
            288,
            460,
            111
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "TrainingEnterHome",
            "[JumpBack]BaseBranchError"
        ]
    },
    /* -------------------- 动作-进入训练所 -------------------- */
    // INFO 进入训练所
    "TrainingEnterHome": {
        "desc": "进入训练所",
        "recognition": "OCR",
        "expected": "训练所",
        "roi": [
            394,
            677,
            84,
            37
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "TrainingBranchHome",
            "[JumpBack]BaseBranchError"
        ]
    },
    /* -------------------- 分支-训练所主页 -------------------- */
    // INFO 主页多个出口
    "TrainingBranchHome": {
        "desc": "在训练所主页",
        "recognition": "And",
        "all_of": [
            "TrainingProbeHomeName",
            "BaseProbeHelpButton",
            "TrainingGetStatus" // INFO 读取完成状态
        ],
        "next": [
            "TrainingCheckEnd",
            "[JumpBack]TrainingEnterOne", // INFO 选择关卡
            "[JumpBack]BaseBranchError"
        ]
    },
    // INFO 读取完成状态
    "TrainingGetStatus": {
        "desc": "获取关卡完成状态",
        "recognition": "Custom",
        "custom_recognition": "TrainingGetStatusReco"
    },
    "TrainingCheckEnd": {
        "desc": "[end] 已无战斗次数",
        "recognition": "Custom",
        "custom_recognition": "TrainingCheckEndReco"
    },
    /* -------------------- 动作-进入关卡 -------------------- */
    "TrainingEnterOne": {
        "desc": "进入其中一个训练所关卡选择页面",
        "recognition": "Custom",
        "custom_recognition": "TrainingEnterOneReco",
        "max_hit": 4,
        "action": "Click",
        "post_wait_freezes": 2000,
        "next": [
            "TrainingEnterFormation",
            "[JumpBack]BaseBranchError",
            "[JumpBack]BaseMoveUp"
        ]
    },
    // INFO 进入编队
    "TrainingEnterFormation": {
        "desc": "进入编队页面",
        "recognition": "Custom",
        "custom_recognition": "TrainingEnterFormationReco",
        "custom_recognition_param": {
            "level": "六"
        },
        "action": "Click",
        "post_wait_freezes": 2000,
        "next": [
            "BattleBranchReplayFormation",
            "[JumpBack]BaseBranchError",
            "[JumpBack]BaseProbeBlackPage"
        ]
    },
    /* -------------------- 动作-战斗胜利 -------------------- */
    "TrainingBattleWin": {
        "desc": "训练所战斗胜利",
        "action": "Custom",
        "custom_action": "TrainingBattleWinAct",
        "next": [
            "TrainingDailyUpdate"
        ]
    },
    // INFO 更新每日一次
    "TrainingDailyUpdate": {
        "desc": "更新每日一次",
        "action": "Custom",
        "custom_action": "TrainingDailyUpdateAct",
        "custom_action_param": {
            "name": [] // 覆写传递关卡名 list
        },
        "next": [
            "TrainingBranchBack",
            "[JumpBack]BaseBranchError"
        ]
    },
    /* -------------------- 动作-返回 -------------------- */
    "TrainingBranchBack": {
        "desc": "从关卡内返回",
        "recognition": "Custom",
        "custom_recognition": "TrainingProbeOneReco",
        "next": [
            "BaseClickBackButton"
        ]
    }
}