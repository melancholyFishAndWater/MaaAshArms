{
    /*
    INFO 训练所任务
    
    使用命名规范版本 v1.2 校验年月日 26/10/13
    */
    "TaskTraining": {
        "desc": "训练所任务",
        "timeout": 60000,
        "next": [
            "[JumpBack]TaskEntrustTrainingGetReward",
            "[JumpBack]TrainingInit",
            "[JumpBack]TrainingProbeDaily",
            "TrainingLoop", // INFO 在训练所
            "[JumpBack]BaseBranchError",
            "[JumpBack]TrainingEnsureHome"
        ]
    },
    "TrainingInit": {
        "desc": "[once][jp] 训练所初始化",
        "max_hit": 1,
        // INFO 调试默认值
        "attach": {
            "战斗演习": "不进行",
            "狩猎行动": "六",
            "拓展训练": "六",
            "资源筹备": "六"
        },
        "action": "Custom",
        "custom_action": "TrainingInitAct"
    },
    /* -------------------- 探测 -------------------- */
    "TrainingProbeHome": {
        "desc": "[end] 在训练所主页面",
        "recognition": "And",
        "all_of": [
            "TrainingProbeHomeName",
            "BaseProbeHelpButton"
        ]
    },
    "TrainingProbeHomeName": {
        "desc": "[end] 有训练所文字",
        "recognition": "OCR",
        "expected": "训练所",
        "roi": [
            109,
            13,
            208,
            49
        ]
    },
    "TrainingProbeDaily": {
        "desc": "[once][jp] 检测每日一次",
        "max_hit": 1,
        "recognition": "Custom",
        "custom_recognition": "TaskTrainingReco",
        "custom_recognition_param": {
            "enable": true // 每日一次开关 覆写关闭
        }
    },
    /* -------------------- 就位 -------------------- */
    "TrainingEnsureHome": {
        "desc": "[jp] 确保在训练所主页面",
        "recognition": "And",
        "all_of": [
            "TrainingProbeHome"
        ],
        "inverse": true,
        "timeout": 30000,
        "next": [
            "TrainingProbeHome",
            "[JumpBack]BaseBranchError",
            "[JumpBack]ProbeBlackPage",
            "[JumpBack]TrainingEnterHome",
            "[JumpBack]BackButton", // INFO 尝试返回按钮(为兼容在关卡内)
            "[JumpBack]BattleEnsureHome"
        ]
    },
    "TrainingEnterHome": {
        "desc": "[jp] 进入训练所",
        "recognition": "OCR",
        "expected": "训练所",
        "roi": [
            394,
            677,
            84,
            37
        ],
        "action": "Click",
        "pre_wait_freezes": 1000,
        "rate_limit": 1500,
        "next": [
            "TrainingLoop",
            "[JumpBack]BaseBranchError",
            "TrainingEnterHome"
        ]
    },
    /* -------------------- 工作 -------------------- */
    "TrainingLoop": {
        "desc": "[Loop] 训练所条件主循环",
        "recognition": "And",
        "all_of": [
            "TrainingProbeHome"
        ],
        "next": [
            "[JumpBack]TrainingGetStatus",
            "[JumpBack]TrainingEnterOne",
            "TrainingCheckEnd",
            "[JumpBack]BaseBranchError"
            // TODO 自律战斗失败的逻辑、不可代理的逻辑
        ]
    },
    "TrainingGetStatus": {
        "desc": "[once][jp] 获取关卡完成状态",
        "recognition": "Custom",
        "custom_recognition": "TrainingGetStatusReco",
        "max_hit": 1
    },
    "TrainingCheckEnd": {
        "desc": "[end] 检测是否无战斗次数",
        "recognition": "And",
        "all_of": [
            "TrainingProbeHome",
            {
                "recognition": "Custom",
                "custom_recognition": "TrainingCheckEndReco"
            }
        ]
    },
    // INFO 关卡选择页面
    "TrainingEnterOne": {
        "desc": "[jp] 进入其中一个训练所关卡选择页面",
        "recognition": "Custom",
        "custom_recognition": "TrainingEnterOneReco",
        "max_hit": 4,
        "action": "Click",
        "next": [
            "TrainingEnterFormation",
            "[JumpBack]MoveUp"
        ],
        "post_wait_freezes": 2000
    },
    "TrainingEnterFormation": {
        "desc": "进入编队页面",
        "recognition": "Custom",
        "custom_recognition": "TrainingEnterFormationReco",
        "custom_recognition_param": {
            "level": "六"
        },
        "action": "Click",
        "next": [
            "BattleLoopReplayFormation",
            "[JumpBack]BaseBranchError",
            "[JumpBack]ProbeBlackPage"
        ],
        "post_wait_freezes": 2000
    },
    "TrainingBattleWin": {
        "desc": "训练所战斗胜利",
        "action": "Custom",
        "custom_action": "TrainingBattleWinAct",
        "next": [
            "TrainingDailyUpdate"
        ]
    },
    // INFO 更新每日一次
    "TrainingDailyUpdate": {
        "desc": "更新每日一次",
        "action": "Custom",
        "custom_action": "TrainingDailyUpdateAct",
        "custom_action_param": {
            "name": [] // 覆写传递关卡名 list
        }
    }
}