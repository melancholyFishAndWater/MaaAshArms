{
    "TaskTraining": {
        "desc": "训练所任务",
        "action": "Custom",
        "custom_action": "TaskTrainingAct",
        // 示例
        // "attach": {
        //     "战斗演习": "六",
        //     "狩猎行动": "六",
        //     "拓展训练": "六",
        //     "资源筹备": "六"
        // },
        "next": [
            "TaskTrainingCheckDaily"
        ]
    },
    "TaskTrainingCheckDaily": {
        "desc": "检测每日一次",
        "recognition": "Custom",
        "custom_recognition": "TaskTrainingReco",
        "custom_recognition_param": {
            "enable": true // 每日一次开关 覆写关闭
        },
        "next": [
            "TrainingInHome",
            "[JumpBack]ReturnTraining"
        ]
    },
    "ReturnTraining": {
        "desc": "返回训练所页面",
        "max_hit": 2,
        "timeout": 600000,
        "next": [
            "TrainingInHome",
            "TrainingEnterHome",
            "[JumpBack]ReturnBattleMainPage"
        ]
    },
    "TrainingEnterHome": {
        "desc": "进入训练所",
        "recognition": "OCR",
        "expected": "训练所",
        "roi": [
            394,
            677,
            84,
            37
        ],
        "action": "Click",
        "pre_wait_freezes": 500,
        "next": [
            "TrainingInHome",
            "TrainingEnterHome"
        ]
    },
    "TrainingInHome": {
        "desc": "在训练所主界面",
        "recognition": "TemplateMatch",
        "template": "Battle/BattleTraining/HomeFlag.png",
        "threshold": 0.975,
        "roi": [
            57,
            0,
            403,
            109
        ],
        "next": [
            "[JumpBack]TrainingEnterOne",
            "TrainingEnd",
            "[JumpBack]TrainingEnterHome",
            "[JumpBack]BackButton",
            "[JumpBack]ReturnBattleMainPage"
            // TODO 自律战斗失败的逻辑、不可代理的逻辑
        ]
    },
    "TrainingEnd": {
        "desc": "无战斗次数",
        "recognition": "TemplateMatch",
        "template": "Battle/BattleTraining/01.png",
        "roi": [
            192,
            524,
            900,
            68
        ],
        "index": 3
    },
    "TrainingEnterOne": {
        "desc": "进入其中一个训练所关卡选择页面",
        "recognition": "Custom",
        "custom_recognition": "TrainingEnterOneRepo",
        "max_hit": 4,
        "action": "Click",
        "next": [
            "TrainingEnterFormation",
            "[JumpBack]MoveUp"
        ],
        "post_wait_freezes": 2000
    },
    "TrainingEnterFormation": {
        "desc": "进入编队页面",
        "recognition": "Custom",
        "custom_recognition": "TrainingEnterFormationRepo",
        "custom_recognition_param": "unknow", // 覆写传递关卡难度数
        "action": "Click",
        "next": [
            "BattleReplay"
        ],
        "post_wait_freezes": 2000
    },
    "TrainingDailyUpdate": {
        "desc": "更新每日一次",
        "action": "Custom",
        "custom_action": "TrainingDailyUpdateAct",
        "custom_action_param": {
            "name": null // 覆写传递关卡名
        }
    }
}