{
    /*
    INFO 自动代理节点

    使用任务链结构 v1.7 校验年月日 26/10/20
    使用节点命名与分类 v1.8 校验年月日 26/10/20
    */
    "TaskReplays": {
        "desc": "自动代理任务",
        "next": [
            "[JumpBack]ReplaysInit",
            "ReplaysLoopFormation",
            "ReplaysLoopBattle",
            "ReplaysLoopDefaultEnd",
            "ReplaysLoopMetalFinish",
            "[JumpBack]BaseBranchError"
        ]
    },
    "ReplaysInit": {
        "desc": "[max] 初始化agent全局变量",
        "max_hit": 1,
        "action": "Custom",
        "custom_action": "ReplaysInitAct",
        "custom_action_param": {
            "times": 2 // 执行次数
        }
    },
    /* -------------------- 工作 -------------------- */
    "ReplaysLoopFormation": {
        "desc": "[Loop] 多次代理编队 循环",
        "recognition": "And",
        "all_of": [
            "BattleProbeFormation"
        ],
        "timeout": 30000,
        "next": [
            "[JumpBack]BattleBranchReplenish",
            "ReplaysLoopLight",
            "BattleStopActionDart",
            "[JumpBack]BattleClickReplay",
            "BattleStopReplayLocked",
            "[JumpBack]BaseBranchError"
        ]
    },
    "ReplaysLoopLight": {
        "desc": "[Loop] 多次代理准备就绪",
        "recognition": "And",
        "all_of": [
            "BattleProbeActionLight",
            "BattleProbeReplayLight"
        ],
        "timeout": 30000,
        "next": [
            "IsNoMetal",
            "BattleStopNoProps",
            "ReplaysLoopBattle",
            "[JumpBack]BattleClickAttack",
            "[JumpBack]BaseBranchError"
        ]
    },
    "ReplaysLoopBattle": {
        "desc": "[Loop] 正在战斗",
        "recognition": "Or",
        "any_of": [
            "BattleProbeLoading",
            "BattleProbeNow"
        ],
        "timeout": 150000,
        "next": [
            "[JumpBack]BattleProbeNow",
            "[JumpBack]BattleProbeLoading",
            "[JumpBack]BattleProbeWin",
            "ReplaysLoopDefaultEnd",
            "ReplaysLoopMetalFinish",
            "[JumpBack]BaseBranchError"
        ]
    },
    // INFO 金属不足
    "ReplaysLoopMetalFinish": {
        "desc": "[Loop] 金属不足结束",
        "recognition": "OCR",
        "expected": "体力不足",
        "roi": [
            411,
            302,
            361,
            51
        ],
        "next": [
            "ReplaysStopMetalFinish",
            "[JumpBack]ClickConfirm",
            "[JumpBack]IsGetReward",
            "[JumpBack]ReplaysClickReattack",
            "[JumpBack]BaseBranchError"
        ]
    },
    "ReplaysStopMetalFinish": {
        "desc": "[end] 金属不足 任务结束",
        "recognition": "And",
        "all_of": [
            "BattleProbeFormation"
        ],
        "action": "StopTask",
        "focus": {
            "Node.Action.Succeeded": "金属不足，任务结束"
        }
    },
    // INFO 正常结束
    "ReplaysLoopDefaultEnd": {
        "desc": "[Loop] 代理正常结束",
        "recognition": "OCR",
        "expected": "已完成\\d+次代理指挥",
        "roi": [
            355,
            198,
            575,
            342
        ],
        "action": "Custom",
        "custom_action": "ReplaysLoopDefaultEndAct",
        "timeout": 30000,
        "next": [
            "ReplaysBranchNextFormation",
            "[JumpBack]ClickConfirm",
            "[JumpBack]IsGetReward",
            "[JumpBack]ReplaysClickReattack",
            "[JumpBack]BaseBranchError"
        ]
    },
    "ReplaysClickReattack": {
        "desc": "[jp] 点击再次出击 进入编队页面",
        "recognition": "OCR",
        "expected": "再次出击",
        "roi": [
            583,
            633,
            123,
            50
        ],
        "action": "Click",
        "post_wait_freezes": 1000
    },
    "ReplaysBranchNextFormation": {
        "desc": "战斗胜利 回到编队页面 判断是结束还是进行下一次战斗",
        "recognition": "And",
        "all_of": [
            "BattleProbeFormation"
        ],
        "next": [
            "ReplaysStopTimes",
            "ReplaysLoopFormation" // INFO 使用大循环 以避开无限时间小循环
        ]
    },
    "ReplaysStopTimes": {
        "desc": "[end] 满足代理次数 任务结束",
        "recognition": "Custom",
        "custom_recognition": "ReplaysStopTimesReco",
        "action": "StopTask"
    }
}