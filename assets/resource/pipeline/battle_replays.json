{
    /*
    INFO 自动代理节点

    使用任务链结构 v3.10 校验年月日 26/11/06
    使用节点命名与分类 v3.3 校验年月日 26/11/06
    */
    "TaskReplays": {
        "desc": "自动代理任务",
        "next": [
            "[JumpBack]ReplaysInit",
            "ReplaysBranchFormation",
            "ReplaysBranchBattle",
            "ReplaysBranchDefaultEnd",
            "ReplaysBranchMetalFinish",
            "[JumpBack]BaseBranchError"
        ],
        "focus": {
            "Node.PipelineNode.Failed": {
                "content": "请阅读此任务详情 确保没有在错误的地方运行",
                "trace": false
            }
        }
    },
    "ReplaysInit": {
        "desc": "[max] 初始化agent全局变量",
        "max_hit": 1,
        "action": "Custom",
        "custom_action": "ReplaysInitAct",
        "custom_action_param": {
            "times": 2 // 执行次数
        }
    },
    /* -------------------- 掉线重连 -------------------- */
    "ReplaysStopConnect": {
        "desc": "[end] 游戏掉线重连成功 代理结束",
        "recognition": "And",
        "all_of": [
            "BaseProbeHome"
        ],
        "action": "StopTask",
        "focus": {
            "Node.Action.Succeeded": {
                "content": "游戏掉线，代理结束",
                "display": [
                    "log",
                    "notification",
                    "modal"
                ]
            }
        }
    },
    /* -------------------- 工作 -------------------- */
    // INFO 见 BattleBranchReplayFormation
    "ReplaysBranchFormation": {
        "desc": "多次代理编队 循环",
        "recognition": "And",
        "all_of": [
            "BattleProbeFormation"
        ],
        "next": [
            "[JumpBack]BattleBranchReplenish",
            "BattleStopActionDart",
            "BattleStopReplayLocked",
            "ReplaysStopReplayOff",
            "ReplaysClickAttack",
            "[JumpBack]BaseBranchError"
        ]
    },
    "ReplaysStopReplayOff": {
        "desc": "未开启代理作战",
        "recognition": "TemplateMatch",
        "template": "Battle/ReplayBattleDart.png",
        "action": "StopTask",
        "focus": {
            "Node.Recognition.Succeeded": "请开启代理作战 并指定次数"
        }
    },
    /* -------------------- 动作-点击出击 -------------------- */
    "ReplaysClickAttack": {
        "desc": "自动代理-点击出击",
        "recognition": "And",
        "all_of": [
            "BattleProbeReplayLight",
            "BattleProbeActionLight"
        ],
        "box_index": 1,
        "action": "Click",
        "post_wait_freezes": 2000,
        "next": [
            "BaseErrorNext",
            "ReplaysBranchBattle",
            "ReplaysClickAttack",
            "[JumpBack]BaseBranchError"
        ],
        "focus": {
            "Node.PipelineNode.Failed": "自动代理出发失败"
        }
    },
    /* -------------------- 战斗中 -------------------- */
    "ReplaysBranchBattle": {
        "desc": "正在战斗",
        "recognition": "Or",
        "any_of": [
            "BattleProbeLoading",
            "BattleProbeNow"
        ],
        "timeout": 150000,
        "next": [
            "[JumpBack]BattleProbeNow",
            "[JumpBack]BattleProbeLoading",
            "[JumpBack]BattleProbeWin",
            "ReplaysBranchDefaultEnd",
            "ReplaysBranchMetalFinish",
            "[JumpBack]BaseBranchError"
        ]
    },
    /* -------------------- 分支-金属不足 -------------------- */
    "ReplaysBranchMetalFinish": {
        "desc": "金属不足结束",
        "recognition": "OCR",
        "expected": "体力不足",
        "roi": [
            411,
            302,
            361,
            51
        ],
        "next": [
            "ReplaysStopMetalFinish",
            "[JumpBack]BaseClickConfirm",
            "[JumpBack]BaseClickRewardTap",
            "[JumpBack]ReplaysClickReattack",
            "[JumpBack]BaseBranchError"
        ]
    },
    "ReplaysStopMetalFinish": {
        "desc": "[end] 金属不足 任务结束",
        "recognition": "And",
        "all_of": [
            "BattleProbeFormation"
        ],
        "action": "StopTask",
        "focus": {
            "Node.Action.Succeeded": "金属不足，任务结束"
        }
    },
    /* -------------------- 分支-正常结束 -------------------- */
    "ReplaysBranchDefaultEnd": {
        "desc": "代理正常结束",
        "recognition": "OCR",
        "expected": "已完成\\d+次代理指挥",
        "roi": [
            355,
            198,
            575,
            342
        ],
        "action": "Custom",
        "custom_action": "ReplaysBranchDefaultEndAct",
        "next": [
            "ReplaysBranchNextFormation",
            "[JumpBack]BaseClickConfirm",
            "[JumpBack]BaseClickRewardTap",
            "[JumpBack]ReplaysClickReattack",
            "[JumpBack]BaseBranchError"
        ]
    },
    "ReplaysClickReattack": {
        "desc": "[jp] 点击再次出击 进入编队页面",
        "recognition": "OCR",
        "expected": "再次出击",
        "roi": [
            583,
            633,
            123,
            50
        ],
        "action": "Click",
        "post_wait_freezes": 1000
    },
    /* -------------------- 分支-结束还是继续 -------------------- */
    "ReplaysBranchNextFormation": {
        "desc": "战斗胜利 回到编队页面 判断是结束还是进行下一次战斗",
        "recognition": "And",
        "all_of": [
            "BattleProbeFormation"
        ],
        "next": [
            "ReplaysStopTimes",
            "ReplaysBranchFormation" // INFO 大循环
        ]
    },
    "ReplaysStopTimes": {
        "desc": "[end] 满足代理次数 任务结束",
        "recognition": "Custom",
        "custom_recognition": "ReplaysStopTimesReco",
        "action": "StopTask"
    }
}