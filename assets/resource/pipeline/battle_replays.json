{
    // INFO 自动代理节点
    "TaskReplays": {
        "desc": "自动代理任务",
        "next": [
            "[JumpBack]ReplaysInit",
            "[JumpBack]LoopErrorByTimesInit",
            "ReplaysStartChooseAttack",
            "ReplaysStartInConfirm",
            "ReplaysStartInBattle",
            "LoopErrorByTimes"
        ]
    },
    "ReplaysInit": {
        "desc": "初始化agent全局变量",
        "action": "Custom",
        "custom_action": "ReplaysInitAct",
        "custom_action_param": {
            "times": 5 // 执行次数
        },
        "max_hit": 1
    },
    // INFO 启动任务时的多种情况
    "ReplaysStartInBattle": {
        "desc": "任务开始时处于战斗中",
        "recognition": "And",
        "all_of": [
            "ReplaysInBattle"
        ],
        "next": [
            "[JumpBack]ReplaysInBattle",
            "ReplaysStartChooseAttack"
        ]
    },
    "ReplaysStartInConfirm": {
        "desc": "在确认界面",
        "recognition": "And",
        "all_of": [
            "ClickConfirm"
        ],
        "next": [
            "[JumpBack]ReplaysEnd",
            "ReplaysMetalEnd",
            "ReplaysStartChooseAttack",
            "LoopErrorByTimes"
        ]
    },
    "ReplaysStartChooseAttack": {
        "desc": "[Loop] 任务开始处于编队界面 点击出击按钮 即使是灰色的",
        "recognition": "OCR",
        "expected": "出击",
        "roi": [
            901,
            612,
            199,
            73
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "timeout": -1,
        "next": [
            "ReplaysNoProps",
            "NoMetal",
            "[JumpBack]ReplaysInBattle",
            "LoopErrorByTimes",
            "ReplaysStartChooseAttack"
        ]
    },
    "ReplaysInBattle": {
        "desc": "[Loop] 正在战斗",
        "recognition": "Or",
        "any_of": [
            "BattleIsLoading",
            "BattleNow"
        ],
        "post_wait_freezes": 3000,
        "timeout": -1,
        "rate_limit": 3000,
        "next": [
            "[JumpBack]BattleNow",
            "[JumpBack]BattleIsLoading",
            "[JumpBack]ReplaysWin",
            "ReplaysEnd",
            "ReplaysMetalEnd",
            "LoopErrorByTimes"
        ]
    },
    // INFO 战斗胜利等待分支
    "ReplaysWin": {
        "desc": "战斗结算，等游戏自己进下一场",
        "recognition": "And",
        "all_of": [
            "BattleWin"
        ],
        "post_wait_freezes": 3000
    },
    // INFO 金属不足结束分支
    "ReplaysMetalEnd": {
        "desc": "金属不足结束",
        "recognition": "OCR",
        "expected": "体力不足",
        "roi": [
            411,
            302,
            361,
            51
        ],
        "next": [
            "[JumpBack]ClickConfirm",
            "[JumpBack]GetReward",
            "ReplaysChooseFinish",
            "LoopErrorByTimes"
        ]
    },
    "ReplaysChooseFinish": {
        "desc": "点击完成",
        "recognition": "OCR",
        "expected": "完成",
        "roi": [
            793,
            633,
            147,
            52
        ],
        "action": "Click",
        "max_hit": 8,
        "next": [
            "ReplaysChooseFinishSuccess",
            "ReplaysChooseFinish"
        ]
    },
    "ReplaysChooseFinishSuccess": {
        "desc": "点击完成成功",
        "recognition": "And",
        "all_of": [
            "ReplaysChooseFinish"
        ],
        "next": [
            "TaskStop"
        ],
        "focus": {
            "Node.Action.Succeeded": "金属不足，任务结束"
        }
    },
    // INFO 代理结束结束分支
    "ReplaysEnd": {
        "desc": "代理正常结束",
        "recognition": "OCR",
        "expected": "已完成\\d+次代理指挥",
        "action": "Custom",
        "custom_action": "ReplaysEndAct",
        "next": [
            "[JumpBack]ClickConfirm",
            "[JumpBack]GetReward",
            "ReplaysChooseReattack",
            "LoopErrorByTimes"
        ]
    },
    "ReplaysChooseReattack": {
        "desc": "点击再次出击 进入编队页面",
        "recognition": "OCR",
        "expected": "再次出击",
        "roi": [
            583,
            633,
            123,
            50
        ],
        "action": "Click",
        "next": [
            "ReplaysChooseReattackSuccess",
            "LoopErrorByTimes",
            "ReplaysChooseReattack"
        ],
        "post_wait_freezes": 1000
    },
    "ReplaysChooseReattackSuccess": {
        "desc": "点击再次出击成功",
        "recognition": "And",
        "all_of": [
            "ReplaysChooseReattack"
        ],
        "action": "Custom",
        "custom_action": "ReplaysChooseReattackSuccessAct",
        "inverse": true
    },
    // INFO 战役道具缺失
    "ReplaysNoProps": {
        "desc": "道具不足",
        "recognition": "OCR",
        "expected": "道具不足",
        "roi": [
            356,
            344,
            617,
            34
        ],
        "action": "StopTask",
        "focus": {
            "Node.Recognition.Succeeded": "道具不足，任务结束"
        }
    }
}