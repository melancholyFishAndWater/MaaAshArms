{
    "TaskStartUp": {
        "desc": "启动游戏任务",
        "next": [
            "StartUpInGame",
            "HomeFlagFirst",
            "StartUpClickIco",
            "StartUpAshArms"
        ]
    },
    // PERF 待优化 启动后立马结束并启动，post_wait_freezes过久导致启动失败且显示所有任务失败
    // INFO 启动的两条路径 b服
    "StartUpClickIco": {
        "desc": "点击游戏图标",
        "recognition": "TemplateMatch",
        "template": [
            "StartUp/GameIcoBiliBili.png"
        ],
        "method": 10001,
        "green_mask": true,
        "action": "Click",
        "order_by": "Score",
        "threshold": 0.8,
        "next": [
            "HomeFlagFirst",
            "StartUpClickIco",
            "[JumpBack]StartUpDisclaimer",
            "[JumpBack]StartUpInLoding",
            "InServerMaintenance",
            "[JumpBack]StartUpGameUpdate",
            "[JumpBack]StartUpGameUpdateError",
            "[JumpBack]StartUpGameUpdateNow",
            "[JumpBack]StartUpClickLogin",
            "StartUpClickSignIn"
        ],
        "post_wait_freezes": 5000,
        "timeout": 300000
    },
    "StartUpAshArms": {
        "desc": "使用安装包启动",
        "action": "StartApp",
        "package": "com.asharmdolls.bilibili",
        "next": [
            "HomeFlagFirst",
            "[JumpBack]StartUpDisclaimer",
            "[JumpBack]StartUpInLoding",
            "InServerMaintenance",
            "[JumpBack]StartUpGameUpdate",
            "[JumpBack]StartUpGameUpdateError",
            "[JumpBack]StartUpGameUpdateNow",
            "[JumpBack]StartUpClickLogin",
            "StartUpClickSignIn"
        ],
        "post_wait_freezes": 5000,
        "timeout": 300000,
        "on_error": [
            "StartUpFailed"
        ]
    },
    "StartUpInGame": {
        "desc": "在游戏中",
        "recognition": "Or",
        "any_of": [
            "BackButton",
            "HomeButton"
        ]
    },
    "StartUpFailed": {
        "desc": "游戏启动失败：禁用启动节点并提示用户",
        "action": "Custom",
        "custom_action": "StartUpFailedAct",
        "custom_action_param": {}, // 键名与默认值由 agent 侧决定
        "focus": {
            "Node.Action.Succeeded": {
                "content": "<span style=\"color:crimson;\">启动游戏失败，请检查是否正确选择游戏资源</span>",
                "display": [
                    "log",
                    "notification",
                    "modal"
                ]
            }
        }
    },
    "StartUpDisclaimer": {
        "desc": "隐私策略",
        "recognition": "OCR",
        "expected": "同意",
        "roi": [
            680,
            531,
            103,
            49
        ],
        "action": "Click",
        "post_wait_freezes": 3000,
        "focus": {
            "Node.Recognition.Succeeded": "点击同意隐私策略"
        }
    },
    "StartUpInLoding": {
        "desc": "正在加载游戏",
        "recognition": "TemplateMatch",
        "template": [
            "StartUp/SignInLoadingFlag/"
        ],
        "post_wait_freezes": 5000,
        "focus": {
            "Node.Recognition.Succeeded": "等待游戏加载中"
        }
    },
    // 点击进入游戏的两个分支
    "StartUpClickLogin": {
        "desc": "点击登录按钮",
        "recognition": "OCR",
        "expected": "登录",
        "roi": [
            512,
            382,
            250,
            46
        ],
        "action": "Click",
        "next": [
            "HomeFlagFirst",
            "[JumpBack]GetReward",
            "[JumpBack]NoticeClickDisable",
            "StartUpClickLogin"
        ],
        "post_wait_freezes": 3000,
        "focus": {
            "Node.Recognition.Succeeded": "点击b站账号登录按钮"
        }
    },
    "StartUpClickSignIn": {
        "desc": "点击进入游戏界面",
        "recognition": "TemplateMatch",
        "template": [
            "StartUp/TouchSignInPage.png"
        ],
        "timeout": 60000,
        "action": "Click",
        "green_mask": true,
        "target": [
            630,
            540
        ],
        "next": [
            "HomeFlagFirst",
            "[JumpBack]GetReward",
            "[JumpBack]NoticeClickDisable",
            "[JumpBack]BackButton",
            "StartUpClickSignIn"
        ],
        "post_wait_freezes": 3000,
        "focus": {
            "Node.Recognition.Succeeded": "点击进入游戏"
        },
        "on_error": [
            "StartUpFailed"
        ]
    },
    "NoticeClickDisable": {
        "desc": "点击公告不再提示",
        "recognition": "OCR",
        "expected": "今日不再提示",
        "action": "Click",
        "next": [
            "NoticeClose"
        ],
        "post_wait_freezes": 1000,
        "focus": {
            "Node.Recognition.Succeeded": "点击公告不再提示"
        }
    },
    "NoticeClose": {
        "desc": "点击其他区域关闭公告页面",
        "action": "Click",
        "target": [
            0,
            -1
        ],
        "post_wait_freezes": 1000,
        "focus": {
            "Node.Recognition.Succeeded": "关闭公告页面"
        }
    },
    "StartUpGameUpdate": {
        "desc": "提示更新",
        "recognition": "OCR",
        "expected": "下载更新",
        "roi": [
            406,
            238,
            120,
            45
        ],
        "next": [
            "ClickConfirm"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "检测到游戏更新"
        }
    },
    "StartUpGameUpdateError": {
        "desc": "更新失败",
        "recognition": "OCR",
        "expected": ".+失败",
        "max_hit": 3,
        "roi": [
            984,
            431,
            796,
            72
        ],
        "next": [
            "ClickConfirm"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "更新失败，尝试重新更新"
        }
    },
    "StartUpGameUpdateNow": {
        "desc": "正在更新",
        "recognition": "OCR",
        "expected": "下载更新",
        "roi": [
            852,
            614,
            89,
            22
        ],
        "post_wait_freezes": 5000,
        "focus": {
            "Node.Recognition.Succeeded": "等待游戏更新中"
        }
    }
}