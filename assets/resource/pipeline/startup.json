{
    /*
    INFO 启动游戏

    使用任务链结构 v3.11 校验年月日 26/11/15
    使用节点命名与分类 v3.3 校验年月日 26/11/15
    */
    "TaskStartUp": {
        "desc": "启动游戏任务",
        "next": [
            "StartUpStopInGame",
            "[JumpBack]BaseProbeBlackPage",
            "[JumpBack]BaseBranchError",
            "StartUpEnterIcon",
            "StartUpEnterPackageBlibili"
        ]
    },
    /* -------------------- 动作-主页内 停止 -------------------- */
    "StartUpStopInGame": {
        "desc": "在游戏中，任务停止",
        "recognition": "Or",
        "any_of": [
            "BaseClickBackButton",
            "BaseClickHomeButton",
            "BaseProbeHome"
        ],
        "action": "StopTask"
    },
    /* -------------------- 动作-启动游戏 --------------------
    b服
    */
    // 点击启动 
    "StartUpEnterIcon": {
        "desc": "点击游戏图标",
        "recognition": "TemplateMatch",
        "template": [
            "StartUp/GameIcoBiliBili.png"
        ],
        "method": 10001,
        "green_mask": true,
        "action": "Click",
        "order_by": "Score",
        "threshold": 0.8,
        "timeout": 60000,
        "rate_limit": 3000,
        "next": [
            "[JumpBack]BaseProbeBlackPage",
            "[JumpBack]StartUpClickDisclaimer",
            "StartUpBranchLoading",
            "[JumpBack]BaseClickErrorConfirm",
            "StartUpEnterSignIn",
            "StartUpEnterLogin"
        ],
        "focus": {
            "Node.PipelineNode.Failed": {
                "content": "使用图标启动游戏失败",
                "display": [
                    "log",
                    "notification",
                    "modal"
                ]
            }
        }
    },
    // 安装包启动
    "StartUpEnterPackageBlibili": {
        "desc": "使用安装包启动",
        "action": "StartApp",
        "package": "com.asharmdolls.bilibili",
        "timeout": 60000,
        "rate_limit": 3000,
        "next": [
            "[JumpBack]BaseProbeBlackPage",
            "[JumpBack]StartUpClickDisclaimer",
            "StartUpBranchLoading",
            "[JumpBack]BaseClickErrorConfirm",
            "StartUpEnterSignIn",
            "StartUpEnterLogin"
        ],
        "focus": {
            "Node.PipelineNode.Failed": {
                "content": "使用安装包启动游戏失败",
                "display": [
                    "log",
                    "notification",
                    "modal"
                ]
            }
        }
    },
    /* -------------------- jp动作-隐私策略 -------------------- */
    "StartUpClickDisclaimer": {
        "desc": "隐私策略",
        "recognition": "OCR",
        "expected": "同意",
        "roi": [
            630,
            481,
            203,
            149
        ],
        "action": "Click",
        "post_wait_freezes": 3000,
        "focus": {
            "Node.Recognition.Succeeded": "点击同意隐私策略"
        }
    },
    /* -------------------- 分支-加载中 -------------------- */
    "StartUpBranchLoading": {
        "desc": "游戏加载中",
        "recognition": "OCR",
        "expected": "\\d",
        "roi": [
            1096,
            576,
            164,
            117
        ],
        "timeout": 60000,
        "rate_limit": 3000,
        "next": [
            "StartUpBranchLoading",
            "BaseStopServerMaintenance",
            "StartUpEnterLogin",
            "StartUpEnterSignIn",
            "[JumpBack]StartUpClickUpdate",
            "[JumpBack]BaseClickErrorConfirm"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "等待游戏加载中"
        }
    },
    /* -------------------- jp动作-点击更新 -------------------- */
    "StartUpClickUpdate": {
        "desc": "[jp] 点击更新游戏",
        "recognition": "And",
        "all_of": [
            "StartUpProbeDownloadText",
            "BaseProbeConfirm"
        ],
        "action": "Click",
        "focus": {
            "Node.Recognition.Succeeded": "游戏更新"
        }
    },
    "StartUpProbeDownloadText": {
        "desc": "[end] 有下载文字",
        "recognition": "OCR",
        "expected": "下载",
        "roi": [
            320,
            148,
            636,
            423
        ]
    },
    /* -------------------- 动作-登录(含公告和签到) -------------------- */
    // 蓝色的登录按钮
    "StartUpEnterLogin": {
        "desc": "点击登录按钮",
        "recognition": "OCR",
        "expected": "登录",
        "roi": [
            512,
            382,
            250,
            46
        ],
        "action": "Click",
        "next": [
            "BaseErrorNext",
            "BaseProbeHome",
            "[JumpBack]BaseClickRewardTap",
            "[JumpBack]StartUpClickNoticeDisable",
            "[JumpBack]BaseClickBackButton",
            "StartUpEnterLogin"
        ],
        "post_wait_freezes": 3000,
        "focus": {
            "Node.Recognition.Succeeded": "游戏掉线，尝试重连"
        }
    },
    // 点击进入游戏
    "StartUpEnterSignIn": {
        "desc": "点击进入游戏",
        "recognition": "TemplateMatch",
        "template": [
            "StartUp/TouchSignInPage.png"
        ],
        "green_mask": true,
        "action": "Click",
        "target": [
            630,
            540
        ],
        "next": [
            "BaseErrorNext",
            "BaseProbeHome",
            "[JumpBack]BaseClickRewardTap",
            "[JumpBack]StartUpClickNoticeDisable",
            "[JumpBack]BaseClickBackButton",
            "StartUpEnterSignIn"
        ],
        "post_wait_freezes": 3000,
        "focus": {
            "Node.Recognition.Succeeded": "点击进入游戏"
        }
    },
    /* -------------------- jp动作-今日不再提示 -------------------- */
    "StartUpClickNoticeDisable": {
        "desc": "[jp] 点击公告不再提示",
        "recognition": "OCR",
        "expected": "今日不再提示",
        "action": "Click",
        "roi": [
            307,
            95,
            246,
            50
        ],
        "next": [
            "StartUpClickNoticeClose"
        ],
        "post_wait_freezes": 1000,
        "focus": {
            "Node.Recognition.Succeeded": "点击公告不再提示"
        }
    },
    // 关闭公告
    "StartUpClickNoticeClose": {
        "desc": "点击其他区域关闭公告页面",
        "action": "Click",
        "target": [
            0,
            -1
        ],
        "post_wait_freezes": 1000,
        "focus": {
            "Node.Recognition.Succeeded": "关闭公告页面"
        }
    }
}