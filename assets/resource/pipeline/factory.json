{
    "TaskFactory": {
        "desc": "开始订单工厂任务",
        "next": [
            "TaskFactoryNext",
            "[JumpBack]ReturnFactory"
        ]
    },
    "ReturnFactory": {
        "desc": "返回订单工厂页面",
        "next": [
            "InFactoryPage",
            "[JumpBack]EnterFactoryFromMain",
            "[JumpBack]ReturnMain"
        ]
    },
    "InFactoryPage": {
        "desc": "在订单工厂",
        "recognition": "OCR",
        "expected": "订单工厂",
        "roi": [
            109,
            5,
            184,
            57
        ]
    },
    "EnterFactoryFromMain": {
        "desc": "从主页进入订单工厂",
        "recognition": "OCR",
        "expected": "订单工厂",
        "roi": [
            598,
            631,
            177,
            89
        ],
        "action": "Click",
        "next": [
            "InFactoryPage",
            "EnterFactoryFromMain"
        ],
        "post_wait_freezes": 1000
    },
    "TaskFactoryNext": {
        "desc": "订单厂任务",
        "recognition": "OCR",
        "expected": "订单工厂",
        "roi": [
            112,
            8,
            198,
            51
        ],
        "next": [
            "CheckFactoryEnd",
            "[JumpBack]InitFactoryItemGetter",
            "[JumpBack]GetFactoryItemStatus",
            "[JumpBack]FactoryTimeEnd",
            "[JumpBack]FactoryCreateOrder",
            "[JumpBack]FactoryMover"
        ]
    },
    "CheckFactoryEnd": {
        "desc": "判断订单工厂任务是否结束",
        "recognition": "Custom",
        "custom_recognition": "CheckFactoryEndReco",
        "custom_recognition_param": "99" // 最大次数，用于调控每日任务的订单工厂
    },
    "InitFactoryItemGetter": {
        "desc": "初始化获得器",
        "max_hit": 1,
        "action": "Custom",
        "custom_action": "InitFactoryItemGetterAct"
    },
    "GetFactoryItemStatus": {
        "desc": "获取工厂订单对象状态",
        "recognition": "Custom",
        "custom_recognition": "GetFactoryItemStatusRepo",
        "action": "StopTask"
    },
    "FactoryMover": {
        "desc": "移动器",
        "action": "Custom",
        "custom_action": "FactoryMoverAct",
        "max_hit": 20
    },
    "FactoryTimeEnd": {
        "desc": "耗时归零则领取",
        "recognition": "Custom",
        "custom_recognition": "FactoryTimeEndRepo",
        "action": "Custom",
        "custom_action": "FactoryTimeEndAct",
        "next": [
            "FactoryCreateOrder",
            "FactoryTimeEnd"
        ],
        "post_wait_freezes": 200
    },
    "FactoryCreateOrder": {
        "desc": "创建新订单",
        "recognition": "OCR",
        "expected": "创建新的订单",
        "roi": [
            560,
            150,
            255,
            500
        ],
        "action": "Click",
        "next": [
            "FactoryChooseCharater",
            "FactoryCreateOrder"
        ],
        "post_wait_freezes": 3000 // 太短容易点到中间角色
    },
    "FactoryChooseCharater": {
        "desc": "选择角色",
        "recognition": "Custom",
        "custom_recognition": "FactoryChooseCharaterRepo",
        "action": "Click",
        "next": [
            "FactoryChooseNumber",
            "FactoryChooseCharater"
        ],
        "post_wait_freezes": 1000
    },
    "FactoryChooseNumber": {
        "desc": "选择建造数",
        "recognition": "Custom",
        "custom_recognition": "FactoryChooseNumberRepo",
        "action": "Click",
        "next": [
            "FactoryChooseStart",
            "FactoryChooseNumber"
        ],
        "post_wait_freezes": 1000
    },
    "FactoryChooseStart": {
        "desc": "选择开始建造按钮",
        "recognition": "OCR",
        "expected": "开始建造",
        "roi": [
            1030,
            127,
            182,
            504
        ],
        "action": "Click",
        "post_wait_freezes": 200,
        "next": [
            "FactoryChooseStart",
            "FactoryChooseStartEnd"
        ]
    },
    "FactoryChooseStartEnd": {
        "desc": "无开始建造按钮",
        "recognition": "And",
        "all_of": [
            "FactoryChooseStart"
        ],
        "inverse": true
    }
}