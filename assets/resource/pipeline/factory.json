{
    // TODO 资源不足时
    "TaskFactory": {
        "desc": "开始订单工厂任务",
        "next": [
            "TaskFactoryNext",
            "[JumpBack]ReturnFactory"
        ]
    },
    "TaskFastFactory": {
        "desc": " 代码中一定要覆写启用FactorySkip!!! CheckFactoryEnd 设置建造前几个角色; FactoryChooseNumber 调控建造数",
        "next": [
            "FastFactoryInit",
            "[JumpBack]ReturnFactory"
        ]
    },
    "ReturnFactory": {
        "desc": "返回订单工厂页面",
        "max_hit": 2,
        "timeout": 600000,
        "next": [
            "EnterFactoryFromMain",
            "[JumpBack]ReturnMain"
        ]
    },
    "EnterFactoryFromMain": {
        "desc": "从主页进入订单工厂",
        "recognition": "OCR",
        "expected": "订单工厂",
        "roi": [
            598,
            631,
            177,
            89
        ],
        "action": "Click",
        "next": [
            "[JumpBack]NetworkError",
            "InFactoryPage",
            "EnterFactoryFromMain",
            "[JumpBack]ReturnMain"
        ]
    },
    "InFactoryPage": {
        "desc": "在订单工厂页面",
        "recognition": "OCR",
        "expected": "订单工厂",
        "roi": [
            112,
            8,
            198,
            51
        ]
    },
    "FastFactoryInit": {
        "desc": "处理干扰项以准备快速建造缺失的角色",
        "recognition": "And",
        "all_of": [
            "InFactoryPage"
        ],
        "next": [
            "[JumpBack]FactorySkip",
            "[JumpBack]FactoryTimeEnd",
            "FastFactoryNext"
        ]
    },
    "FastFactoryNext": {
        "desc": "快速建造前x个缺失的角色",
        "action": "Custom",
        "custom_action": "InitFactoryItemGetterAct",
        "next": [
            "[JumpBack]FactorySkip",
            "[JumpBack]FactoryTimeEnd",
            "CheckFactoryEnd",
            "[JumpBack]FactoryCreateOrder"
        ]
    },
    "TaskFactoryNext": {
        "desc": "订单厂任务",
        "recognition": "OCR",
        "expected": "订单工厂",
        "roi": [
            112,
            8,
            198,
            51
        ],
        "action": "Custom",
        "custom_action": "InitFactoryItemGetterAct", // 初始化获得器
        "next": [
            "[JumpBack]GetFactoryItemStatus",
            "CheckFactoryEnd",
            "[JumpBack]FactorySkip",
            "[JumpBack]FactoryTimeEnd",
            "[JumpBack]FactoryCreateOrder",
            "[JumpBack]FactoryMover"
        ]
    },
    "GetFactoryItemStatus": {
        "desc": "获取工厂订单对象状态 始终不会命中",
        "recognition": "Custom",
        "custom_recognition": "GetFactoryItemStatusRepo"
    },
    "FactoryMover": {
        "desc": "移动器 控制页面上下移动找到未识别位置或完成位置",
        "action": "Custom",
        "custom_action": "FactoryMoverAct",
        "max_hit": 20
    },
    "CheckFactoryEnd": {
        "desc": "判断订单工厂任务是否结束",
        "recognition": "Custom",
        "custom_recognition": "CheckFactoryEndReco",
        "custom_recognition_param": 4 // 最大收获次数
    },
    "FactorySkip": {
        "desc": "跳过建造等待 默认关闭",
        "recognition": "OCR",
        "expected": "加速建造",
        "enabled": false,
        "roi": [
            1030,
            127,
            182,
            504
        ],
        "action": "Click",
        "post_wait_freezes": 500,
        "next": [
            "FactoryClickSkipOk"
        ]
    },
    // TODO 验证是否有多余生产许可
    "FactoryClickSkipOk": {
        "desc": "点击确认跳过按钮",
        "recognition": "OCR",
        "expected": "确认",
        "roi": [
            683,
            422,
            196,
            66
        ]
    },
    "FactoryTimeEnd": {
        "desc": "耗时归零则领取",
        "recognition": "Custom",
        "custom_recognition": "FactoryTimeEndRepo", // 返回红叉位置
        "action": "Custom",
        "custom_action": "FactoryTimeEndAct",
        "next": [
            "FactoryTimeEndSuccess",
            "FactoryTimeEnd"
        ],
        "post_wait_freezes": 1000
    },
    "FactoryTimeEndSuccess": {
        "desc": "判断FactoryTimeEnd成功的标志",
        "recognition": "OCR",
        "expected": "创建新的订单",
        "roi": "FactoryTimeEnd",
        "roi_offset": [
            -620,
            110,
            200,
            50
        ]
    },
    // 创建新订单系列动作
    "FactoryCreateOrder": {
        "desc": "创建新订单",
        "recognition": "OCR",
        "expected": "创建新的订单",
        "roi": [
            560,
            150,
            255,
            500
        ],
        "action": "Click",
        "next": [
            "FactoryChooseCharater",
            "FactoryCreateOrder"
        ],
        "post_wait_freezes": 3000 // 太短容易点到中间角色
    },
    "FactoryChooseCharater": {
        "desc": "选择角色",
        "recognition": "Custom",
        "custom_recognition": "FactoryChooseCharaterRepo",
        "action": "Click",
        "next": [
            "FactoryChooseNumber",
            "FactoryChooseCharater"
        ],
        "post_wait_freezes": 1000
    },
    "FactoryChooseNumber": {
        "desc": "选择建造数",
        "recognition": "Custom",
        "custom_recognition": "FactoryChooseNumberRepo",
        "custom_recognition_param": 1, // 建造数
        "action": "Click",
        "next": [
            "FactoryChooseStart",
            "FactoryChooseNumber"
        ],
        "post_wait_freezes": 1000
    },
    "FactoryChooseStart": {
        "desc": "选择开始建造按钮",
        "recognition": "OCR",
        "expected": "开始建造",
        "roi": [
            1030,
            127,
            182,
            504
        ],
        "action": "Click",
        "post_wait_freezes": 200,
        "next": [
            "FactoryChooseStart",
            "FactoryChooseStartEnd"
        ]
    },
    "FactoryChooseStartEnd": {
        "desc": "无开始建造按钮",
        "recognition": "And",
        "all_of": [
            "FactoryChooseStart"
        ],
        "inverse": true,
        "action": "Custom",
        "custom_action": "FactoryChooseStartEndAct"
    }
}