{
    /*
    INFO 工厂任务

    使用任务链结构 v3.10 校验年月日 26/11/06
    使用节点命名与分类 v3.3 校验年月日 26/11/06
    */
    "TaskFactory": {
        "desc": "订单工厂任务",
        "next": [
            "[JumpBack]FactoryProbeDaily",
            "FactoryBranchHome",
            "FactoryEnterHome",
            "[JumpBack]BaseBranchError",
            "[JumpBack]BaseReturnHome"
        ]
    },
    "FactoryProbeDaily": {
        "desc": "[jp][once] 检查每日一次",
        "max_hit": 1,
        "recognition": "Custom",
        "custom_recognition": "FactoryProbeDailyReco",
        "custom_recognition_param": {
            "enable": true // 每日一次开关 覆写关闭
        }
    },
    /* -------------------- 通用探测 -------------------- */
    "FactoryProbeHome": {
        "desc": "在订单工厂页面",
        "recognition": "OCR",
        "expected": "订单工厂",
        "roi": [
            112,
            8,
            198,
            51
        ]
    },
    /* -------------------- 动作-进入主页 -------------------- */
    "FactoryEnterHome": {
        "desc": "从主页进入订单工厂",
        "recognition": "OCR",
        "expected": [
            "订",
            "单",
            "工",
            "厂"
        ],
        "roi": [
            637,
            650,
            103,
            70
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "BaseErrorNext",
            "FactoryBranchHome",
            "FactoryEnterHome",
            "[JumpBack]BaseBranchError"
        ]
    },
    /* -------------------- 主页 -------------------- */
    "FactoryBranchHome": {
        "desc": "订单厂任务",
        "recognition": "OCR",
        "expected": "订单工厂",
        "roi": [
            112,
            8,
            198,
            51
        ],
        "action": "Custom",
        "custom_action": "TaskFactoryNextAct", // 初始化
        "custom_action_param": {
            "build_times": 1 // 建造数
        },
        "next": [
            "FactoryCheckTaskEnd",
            "[JumpBack]FactoryClickSkip",
            "[JumpBack]FactoryGetReward",
            "[JumpBack]FactoryClickCreateOrder",
            "[JumpBack]FactoryChooseCharacter",
            // TODO 子节点卡住
            "[JumpBack]BaseBranchError",
            "[JumpBack]BaseMoveUpDown"
        ]
    },
    // INFO 是否结束
    "FactoryCheckTaskEnd": {
        "desc": "检测任务是否满足结束条件",
        "recognition": "Custom",
        "custom_recognition": "FactoryCheckTaskEndReco",
        "custom_recognition_param": 3, // 建造次数,
        "next": [
            "FactoryDailyUpdate"
        ]
    },
    // INFO 更新每日一次
    "FactoryDailyUpdate": {
        "desc": "更新每日一次",
        "action": "Custom",
        "custom_action": "FactoryDailyUpdateAct",
        "next": [
            "BaseTaskStop"
        ]
    },
    /* -------------------- 分支-跳过 -------------------- */
    "FactoryClickSkip": {
        "desc": "跳过建造等待 默认关闭",
        "recognition": "OCR",
        "expected": "加速建造",
        "enabled": false,
        "roi": [
            1030,
            127,
            182,
            504
        ],
        "action": "Click",
        "post_wait_freezes": 500,
        "next": [
            "FactoryClickSkipConfirm",
            "[JumpBack]BaseBranchError"
        ]
    },
    // TODO 验证是否有多余生产许可
    "FactoryClickSkipConfirm": {
        "desc": "点击确认跳过按钮",
        "recognition": "TemplateMatch",
        "template": "Base/Confirm.png",
        "method": 10001,
        "roi": [
            683,
            422,
            196,
            66
        ]
    },
    /* -------------------- 分支-领取奖励 -------------------- */
    "FactoryGetReward": {
        "desc": "领取奖励",
        "recognition": "Custom",
        "custom_recognition": "FactoryGetRewardReco", // 返回红叉位置
        "action": "Click",
        "target_offset": [
            -892,
            154,
            -31,
            -31
        ],
        "post_wait_freezes": 500,
        "next": [
            "BaseErrorNext",
            "FactoryGetRewardSuccess",
            "FactoryGetRewardFailed",
            "[JumpBack]BaseBranchError",
            "FactoryGetRewardBox"
        ]
    },
    // 点击领取区域
    "FactoryGetRewardBox": {
        "desc": "[jp] 点击领取区域",
        "target": "FactoryGetReward",
        "action": "Click",
        "target_offset": [
            -892,
            154,
            -31,
            -31
        ],
        "post_wait_freezes": 1000
    },
    // 领取成功
    "FactoryGetRewardSuccess": {
        "desc": "领取奖励成功",
        "recognition": "TemplateMatch",
        "template": "Factory/CancelButtonGreen.png",
        "green_mask": true,
        "inverse": true,
        "roi": "FactoryGetReward",
        "roi_offset": [
            -50,
            -50,
            100,
            100
        ],
        "action": "Custom",
        "custom_action": "FactoryGetRewardNextAct"
    },
    /* -------------------- 分支-领取失败 -------------------- */
    "FactoryGetRewardFailed": {
        "desc": "领取奖励失败 库存满",
        "roi": [
            362,
            253,
            285,
            141
        ],
        "recognition": "OCR",
        "expected": "库存数量已达上限",
        "next": [
            "[JumpBack]BaseClickConfirm",
            "FactoryClickCancel"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "库存满，删除订单"
        }
    },
    // 点击取消
    "FactoryClickCancel": {
        "desc": "点击取消建造按钮",
        "target": "FactoryGetReward",
        "action": "Click",
        "next": [
            "[JumpBack]BaseClickConfirm",
            "FactoryClickCancelEnd"
        ]
    },
    // 点击成功
    "FactoryClickCancelEnd": {
        "desc": "确认取消订单完毕",
        "recognition": "OCR",
        "expected": "取消订单",
        "inverse": true,
        "roi": [
            362,
            193,
            208,
            142
        ],
        "action": "Custom",
        "custom_action": "FactoryGetRewardNextAct"
    },
    /* -------------------- 分支-创建订单 -------------------- */
    "FactoryClickCreateOrder": {
        "desc": "点击创建新订单",
        "recognition": "OCR",
        "expected": "创建新的订单",
        "roi": [
            560,
            174,
            255,
            419
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "timeout": 60000,
        "rate_limit": 3000,
        "next": [
            "FactoryChooseCharacter",
            "[JumpBack]BaseBranchError"
        ]
    },
    // 点击角色
    "FactoryChooseCharacter": {
        "desc": "选择角色",
        "recognition": "Custom",
        "custom_recognition": "FactoryChooseCharacterReco",
        "action": "Click",
        "post_wait_freezes": 1000,
        "timeout": 60000,
        "rate_limit": 3000,
        "next": [
            "FactoryChooseNumber",
            "[JumpBack]BaseBranchError"
        ]
    },
    // 点击建造数
    "FactoryChooseNumber": {
        "desc": "选择建造数",
        "recognition": "OCR",
        "expected": "^建造$",
        "roi": [
            102,
            162,
            1114,
            485
        ],
        "order_by": "Horizontal",
        "index": 0, // 建造数 agent 侧覆写
        "action": "Click",
        "next": [
            "BaseErrorNext",
            "FactoryClickStart",
            "[JumpBack]BaseBranchError",
            "FactoryChooseNumber"
        ],
        "post_wait_freezes": 1000
    },
    // 点击开始建造
    "FactoryClickStart": {
        "desc": "选择开始建造",
        "recognition": "OCR",
        "expected": "开始建造",
        "roi": [
            1030,
            127,
            182,
            504
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "BaseErrorNext",
            "FactoryStopNoMetal",
            "FactoryClickSkip",
            "FactoryChooseStartSuccess",
            "FactoryClickStart"
        ]
    },
    "FactoryChooseStartSuccess": {
        "desc": "建造成功",
        "recognition": "And",
        "all_of": [
            "FactoryClickStart"
        ],
        "inverse": true,
        "action": "Custom",
        "custom_action": "FactoryChooseStartSuccessAct"
    },
    /* -------------------- 分支-资源不足 -------------------- */
    "FactoryStopNoMetal": {
        "desc": "建造失败 资源不足",
        "recognition": "OCR",
        "expected": "资源不足",
        "roi": [
            411,
            305,
            117,
            43
        ],
        "next": [
            "[JumpBack]BaseClickConfirm",
            "BaseTaskStop"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "合金不足，任务结束"
        }
    }
}