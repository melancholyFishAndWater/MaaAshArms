{
    // INFO 工厂任务入口
    "TaskFactory": {
        "desc": "开始订单工厂任务",
        "recognition": "Custom",
        "custom_recognition": "TaskFactoryReco",
        "custom_recognition_param": {
            "enable": true // 每日一次开关 覆写关闭
        },
        "next": [
            "TaskFactoryNext",
            "[JumpBack]ReturnFactory"
        ]
    },
    // 返回工厂页面
    "ReturnFactory": {
        "desc": "返回订单工厂页面",
        "max_hit": 2,
        "timeout": 600000,
        "next": [
            "FactoryEnterHome",
            "[JumpBack]ReturnMain"
        ]
    },
    "FactoryEnterHome": {
        "desc": "从主页进入订单工厂",
        "recognition": "OCR",
        "expected": "订单工厂",
        "roi": [
            598,
            631,
            177,
            89
        ],
        "action": "Click",
        "next": [
            "FactoryInHome",
            "FactoryEnterHome",
            "[JumpBack]ReturnMain"
        ],
        "post_wait_freezes": 3000
    },
    "FactoryInHome": {
        "desc": "在订单工厂页面",
        "recognition": "OCR",
        "expected": "订单工厂",
        "roi": [
            112,
            8,
            198,
            51
        ]
    },
    // INFO 工厂任务
    "TaskFactoryNext": {
        "desc": "订单厂任务",
        "recognition": "OCR",
        "expected": "订单工厂",
        "roi": [
            112,
            8,
            198,
            51
        ],
        "action": "Custom",
        "custom_action": "TaskFactoryNextAct",
        "next": [
            "FactoryCheckTaskEnd",
            "[JumpBack]FactorySkip",
            "[JumpBack]FactoryGetReward",
            "[JumpBack]FactoryCreateOrder",
            // TODO 子节点卡住
            "[JumpBack]MoveUpDown",
            "TaskStop"
        ]
    },
    // 特殊节点
    "FactoryCheckTaskEnd": {
        "desc": "检测任务是否满足结束条件",
        "recognition": "Custom",
        "custom_recognition": "FactoryCheckTaskEndRepo",
        "custom_recognition_param": 3, // 建造次数 超过3最好开启skip,
        "next": [
            "FactoryDailyUpdate"
        ]
    },
    "FactoryDailyUpdate": {
        "desc": "更新每日一次",
        "action": "Custom",
        "custom_action": "FactoryDailyUpdateAct",
        "next": [
            "TaskStop"
        ]
    },
    // 跳过系列
    "FactorySkip": {
        "desc": "跳过建造等待 默认关闭",
        "recognition": "OCR",
        "expected": "加速建造",
        "enabled": false,
        "roi": [
            1030,
            127,
            182,
            504
        ],
        "action": "Click",
        "post_wait_freezes": 500,
        "next": [
            "FactoryClickSkipOk"
        ]
    },
    // TODO 验证是否有多余生产许可
    "FactoryClickSkipOk": {
        "desc": "点击确认跳过按钮",
        "recognition": "OCR",
        "expected": "确认",
        "roi": [
            683,
            422,
            196,
            66
        ]
    },
    // INFO 分节点-领取奖励
    "FactoryGetReward": {
        "desc": "领取奖励",
        "recognition": "Custom",
        "custom_recognition": "FactoryGetRewardReco", // 返回红叉位置
        "action": "Click",
        "target_offset": [
            -892,
            154,
            -31,
            -31
        ],
        "next": [
            "FactoryGetRewardSuccess",
            "FactoryGetRewardFaild",
            "FactoryGetReward"
        ],
        "post_wait_freezes": 3000 // 太短容易导致点到创建订单
    },
    "FactoryGetRewardSuccess": {
        "desc": "领取奖励成功",
        "recognition": "TemplateMatch",
        "template": "Factory/CancelButtonGreen.png",
        "green_mask": true,
        "inverse": true,
        "roi": "FactoryGetReward",
        "roi_offset": [
            -50,
            -50,
            100,
            100
        ],
        "action": "Custom",
        "custom_action": "FactoryGetRewardNextAct"
    },
    "FactoryGetRewardFaild": {
        "desc": "领取奖励失败 库存满",
        "roi": [
            362,
            253,
            285,
            141
        ],
        "recognition": "OCR",
        "expected": "库存数量已达上限",
        "next": [
            "[JumpBack]ClickConfirm",
            "FactoryClickCancel"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "库存满，删除订单"
        }
    },
    "FactoryClickCancel": {
        "desc": "点击取消建造按钮",
        "target": "FactoryGetReward",
        "action": "Click",
        "next": [
            "[JumpBack]ClickConfirm",
            "FactoryClickCancelEnd"
        ]
    },
    "FactoryClickCancelEnd": {
        "desc": "确认取消订单完毕",
        "recognition": "OCR",
        "expected": "取消订单",
        "inverse": true,
        "roi": [
            362,
            193,
            208,
            142
        ],
        "action": "Custom",
        "custom_action": "FactoryGetRewardNextAct"
    },
    // max_hit 限制创建次数
    // INFO 分节点-创建新订单
    "FactoryCreateOrder": {
        "desc": "创建新订单",
        "recognition": "OCR",
        "expected": "创建新的订单",
        "roi": [
            560,
            150,
            255,
            500
        ],
        "action": "Click",
        "next": [
            "FactoryChooseCharater",
            "FactoryChooseNumber", // 还是点到那就这样吧
            "FactoryCreateOrder"
        ],
        "post_wait_freezes": 4000 // 太短容易点到中间角色
    },
    "FactoryChooseCharater": {
        "desc": "选择角色",
        "recognition": "Custom",
        "custom_recognition": "FactoryChooseCharaterRepo",
        "action": "Click",
        "next": [
            "FactoryChooseNumber",
            "FactoryChooseCharater"
        ],
        "post_wait_freezes": 1000
    },
    "FactoryChooseNumber": {
        "desc": "选择建造数",
        "recognition": "Custom",
        "custom_recognition": "FactoryChooseNumberRepo",
        "custom_recognition_param": 1, // 建造数
        "action": "Click",
        "next": [
            "FactoryChooseStart",
            "FactoryChooseNumber"
        ],
        "post_wait_freezes": 1000
    },
    "FactoryChooseStart": {
        "desc": "选择开始建造按钮",
        "recognition": "OCR",
        "expected": "开始建造",
        "roi": [
            1030,
            127,
            182,
            504
        ],
        "action": "Click",
        "post_wait_freezes": 1000,
        "next": [
            "FactoryChooseStart",
            "FactoryChooseStartFail",
            "FactorySkip",
            "FactoryChooseStartSuccess"
        ]
    },
    "FactoryChooseStartSuccess": {
        "desc": "建造成功",
        "recognition": "And",
        "all_of": [
            "FactoryChooseStart"
        ],
        "inverse": true,
        "action": "Custom",
        "custom_action": "FactoryChooseStartSuccessAct"
    },
    "FactoryChooseStartFail": {
        "desc": "建造失败 资源不足",
        "recognition": "OCR",
        "expected": "资源不足",
        "roi": [
            411,
            305,
            117,
            43
        ],
        "next": [
            "ClickConfirm"
        ],
        "focus": {
            "Node.Recognition.Succeeded": "合金不足，任务结束"
        }
    }
}