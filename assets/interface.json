{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaAshArms",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "QQ群: 无",
    "license": "MIT",
    "welcome": "首次使用！欢迎使用 MAA!",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/melancholyFishAndWater/MaaAshArms",
    "version": "0.1.0-alpha.13",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        // {
        //     "name": "官服",
        //     "path": [
        //         "./resource"
        //     ]
        // },
        {
            "name": "B 服",
            "path": [
                "./resource"
                // "./resource_bilibili"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "启动游戏",
            "entry": "TaskStartUp"
        },
        {
            "name": "收取资源",
            "entry": "TaskFeiduReward"
        },
        {
            "name": "每日赠礼",
            "entry": "TaskGiveGift"
        },
        {
            "name": "维修会",
            "entry": "TaskMaintenance"
        },
        {
            "name": "武装押运",
            "entry": "TaskTrain",
            "option": [
                // TODO 路线选择
            ]
        },
        {
            "name": "防卫局",
            "entry": "TaskEscort"
        },
        {
            "name": "联络人",
            "entry": "TaskFriend"
        },
        {
            "name": "订单工厂",
            "entry": "TaskFactory",
            "option": [
                "建造数量",
                "跳过"
            ]
        },
        {
            "name": "训练所",
            "entry": "TaskTrainingCenter"
        },
        {
            "name": "领取奖励",
            "entry": "TaskMission"
        }
        // {
        //     "name": "自律活动",
        //     "entry": "TaskAutoActivity",
        //     "description": "使用自律作战打活动，需要先打开活动的选择关卡页面。\n一定要在战前选好默认队伍的战斗角色。\n每战都会点击一键补充",
        //     "option": [
        //         // "战前一键补充"
        //     ]
        // }
    ],
    "option": {
        "建造数量": {
            "type": "input",
            "description": "单次建造数量，超过3个时，要开启跳过才生效",
            "inputs": [
                {
                    "name": "number",
                    "default": "3",
                    "pipeline_type": "int",
                    "verify": "^\\d$",
                    "pattern_msg": "请输入数字"
                }
            ],
            "pipeline_override": {
                "FactoryCheckTaskEnd": {
                    "custom_recognition_param": "{number}"
                }
            }
        },
        "跳过": {
            "type": "switch",
            "description": "跳过建造等待",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "FactorySkip": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No"
                }
            ]
        }
    }
}