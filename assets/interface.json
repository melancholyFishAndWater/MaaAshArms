{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaAshArms",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "QQ群: 无",
    "license": "MIT",
    "welcome": "resource/announcement/0-welcome.md",
    // 填写项目地址和版本号可实现自动更新功能
    "github": "https://github.com/melancholyFishAndWater/MaaAshArms",
    "version": "1.0.0-beta.1",
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "B 服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "启动游戏",
            "entry": "TaskStartUp"
        },
        {
            "name": "收取资源",
            "entry": "TaskFeiduReward",
            "group": [
                "feidu"
            ]
        },
        {
            "name": "每日赠礼",
            "entry": "TaskGift",
            "group": [
                "feidu",
                "daily"
            ],
            "option": [
                "gift_daily"
            ]
        },
        {
            "name": "维修会",
            "entry": "TaskMaintenance"
        },
        {
            "name": "武装押运",
            "entry": "TaskTrain",
            "option": [
                // TODO 路线选择
            ]
        },
        {
            "name": "防卫局",
            "entry": "TaskEscort",
            "pipeline_override": {
                "IsFreezes": {
                    "roi": [
                        0,
                        0,
                        1280,
                        481
                    ],
                    "next": [
                        "TaskStop"
                    ]
                }
            }
        },
        {
            "name": "联络人",
            "entry": "TaskFriend"
        },
        {
            "name": "订单工厂",
            "entry": "TaskFactory",
            "group": [
                "daily"
            ],
            "option": [
                "自定义数量",
                "build_skip"
            ]
        },
        {
            "name": "训练所",
            "entry": "TaskTraining",
            "group": [
                "daily"
            ],
            "option": [
                "战斗演习",
                "狩猎行动",
                "拓展训练",
                "资源筹备"
            ]
        },
        {
            "name": "任务奖励",
            "entry": "TaskMission"
        }
        // {
        //     "name": "自律活动",
        //     "entry": "TaskAutoActivity",
        //     "description": "使用自律作战打活动，需要先打开活动的选择关卡页面。\n一定要在战前选好默认队伍的战斗角色。\n每战都会点击一键补充",
        //     "option": [
        //         // "战前一键补充"
        //     ]
        // }
    ],
    "group": [
        {
            "name": "feidu",
            "label": "废都",
            "default_expand": true
        },
        {
            "name": "daily",
            "label": "每日任务",
            "default_expand": true,
            "description": "每日任务分组下的任务每日只会执行一次"
        }
    ],
    "import": [
        "resource/tasks/option/battle_training.json",
        "resource/tasks/option/factory.json",
        "resource/tasks/option/daily.json"
    ]
}