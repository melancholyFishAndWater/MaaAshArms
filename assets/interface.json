    "interface_version": 2,
    "name": "MaaAshArms",
    "description": "这是一个使用 MaaFramework 创建的新项目。",
    "contact": "QQ群: 1128946439",
    "license": "MIT",
    "welcome": "resource/announcement/0-welcome.md",
    "github": "https://github.com/melancholyFishAndWater/MaaAshArms",
    "version": "1.0.0-beta.30",
    "telemetry": {
        "sentry": {
            "dsn": "https://f231f330aaf9138fe2fd690d70f82d94@o4512197377523712.ingest.us.sentry.io/4512197395480576",
            "failure_attachments_sample_rate": 1,
            "environment": "production"
        }
    },
    // Mirror酱为第三方分发服务，新项目默认关闭
    // 若有需要请联系 Mirror酱 开通，直接自行开启是无法使用的
    // "mirrorchyan_rid": "MaaXXX",
    // "mirrorchyan_multiplatform": true,
    "controller": [
        {
            "name": "安卓端",
            "type": "Adb",
            "display_short_side": 720 // 默认缩放分辨率的短边长度
        }
    ],
    "resource": [
        {
            "name": "B 服",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "StartUp",
            "label": "启动游戏",
            "entry": "TaskStartUp",
            "default_check": true
        },
        {
            "name": "Friend",
            "label": "联络人",
            "entry": "TaskFriend",
            "default_check": true
        },
        {
            "name": "Reward",
            "label": "收取资源",
            "entry": "TaskFeiduReward",
            "group": [
                "feidu"
            ],
            "default_check": true
        },
        {
            "name": "Gift",
            "label": "每日赠礼",
            "entry": "TaskGift",
            "default_check": true,
            "group": [
                "feidu",
                "daily"
            ],
            "option": [
                "gift_daily"
            ]
        },
        {
            "name": "Entrust",
            "label": "委派",
            "entry": "TaskEntrust",
            "default_check": true,
            "group": [
                "daily",
                "metal"
            ],
            "option": [
                "entrust_daily"
            ],
            "pipeline_override": {
                "MoveRight": {
                    "max_hit": 20
                }
            },
            "description": "此任务必须位于[任务奖励]前，才能领取今日委派奖励"
        },
        {
            "name": "Maintenance",
            "label": "维修会",
            "entry": "TaskMaintenance",
            "default_check": true,
            "group": [
                "metal"
            ]
        },
        {
            "name": "Train",
            "label": "武装押运",
            "entry": "TaskTrain",
            "default_check": true,
            "group": [
                "metal"
            ],
            "option": [
                // TODO 路线选择
            ]
        },
        {
            "name": "Escort",
            "label": "防卫局",
            "entry": "TaskEscort",
            "default_check": true,
            "pipeline_override": {
                "IsFreezes": {
                    "roi": [
                        0,
                        0,
                        1280,
                        481
                    ],
                    "next": [
                        "TaskStop"
                    ]
                }
            }
        },
        {
            "name": "Factory",
            "label": "订单工厂",
            "entry": "TaskFactory",
            "default_check": true,
            "group": [
                "daily",
                "metal"
            ],
            "option": [
                "build_number",
                "build_skip",
                "factory_daily"
            ]
        },
        {
            "name": "Training",
            "label": "训练所",
            "entry": "TaskTraining",
            "default_check": true,
            "group": [
                "daily",
                "metal"
            ],
            "option": [
                "training_daily",
                "战斗演习",
                "狩猎行动",
                "拓展训练",
                "资源筹备"
            ],
            "pipeline_override": {
                "BattleWinSuccess": {
                    "next": [
                        "TrainingDailyUpdate"
                    ]
                }
            }
        },
        {
            "name": "Mission",
            "label": "任务奖励",
            "entry": "TaskMission",
            "default_check": true
        },
        {
            "name": "Replays",
            "label": "自动代理",
            "entry": "TaskReplays",
            "default_check": false,
            "description": "自动进行代理作战，支持主线和战役<br/>[color:red]必须在战斗编队页面且设置好代理指挥次数[/color]",
            "option": [
                "battle_replays_number"
            ],
            "group": [
                "metal"
            ]
        }
        // TODO
        // {
        //     "name": "自律活动",
        //     "entry": "TaskAutoActivity",
        //     "description": "使用自律作战打活动，需要先打开活动的选择关卡页面。\n一定要在战前选好默认队伍的战斗角色。\n每战都会点击一键补充",
        //     "option": [
        //         // "战前一键补充"
        //     ]
        // }
    ],
    "group": [
        {
            "name": "feidu",
            "label": "废都",
            "default_expand": false
        },
        {
            "name": "daily",
            "label": "每日任务",
            "default_expand": true,
            "description": "每日任务分组下的任务允许：完成每日任务指标后不再进行"
        },
        {
            "name": "metal",
            "label": "消耗合金",
            "default_expand": false,
            "description": "这些任务消耗合金，需要与收取资源任务看情况排，或直接收取两次"
        }
    ],
    "import": [
        "resource/tasks/option/battle_training.json",
        "resource/tasks/option/factory.json",
        "resource/tasks/option/feidu_gift.json",
        "resource/tasks/option/entrust.json",
        "resource/tasks/option/battle_replays.json",
        "resource/tasks/preset/default.json"
    ]
}