{
    "include": [
        "../../tools",
        "../../agent"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__"
    ],
    "python.analysis.extraPaths": [
        "agent",
        "agent/shared"
    ],
    "typeCheckingMode": "basic",
    "reportMissingImports": "warning",
    "reportMissingTypeStubs": "none"
}