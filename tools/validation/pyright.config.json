{
    "include": [
        "../../tools",
        "../../agent"
    ],
    "exclude": [
        "**/node_modules",
        "**/__pycache__",
        "../../tools/**/*.new.py",
        "../../agent/**/*.new.py"
    ],
    "venvPath": "../..",
    "venv": ".venv",
    "extraPaths": [
        "../../agent",
        "../../agent/shared"
    ],
    "typeCheckingMode": "basic",
    "reportMissingImports": "warning",
    "reportMissingTypeStubs": "none"
}
