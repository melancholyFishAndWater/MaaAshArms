{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "$comment": "使用命名规范 v1.9; 使用任务链结构 v1.8",
    "patternProperties": {
        "^(?!\\$).*": {
            "defaultSnippets": [
                {
                    "label": "<> 空节点",
                    "body": {
                        "desc": "$0"
                    }
                },
                {
                    "label": "Probe 探测节点",
                    "body": {
                        "desc": "[end] $1",
                        "recognition": "$0",
                        "roi": []
                    }
                },
                {
                    "label": "Branch 分支节点",
                    "$comment": "识别到该状态就把 next 交出去：不写 action、不保证页面、不回到自己（node-naming.md §3）。页面导航默认用它平铺到调用方 next，代替嵌套 Ensure（结构文档 §10）",
                    "body": {
                        "desc": "$1",
                        "recognition": "And",
                        "all_of": [
                            "$2"
                        ],
                        "next": [
                            "$0"
                        ]
                    }
                },
                {
                    "label": "Ensure 就位节点",
                    "$comment": "next 末项：单层 Ensure 写最后一个兜底候选（通常是回主页那一级）；嵌套 Ensure 写上一级 Ensure（结构文档 §2）。嵌套深度上限 2 层，第 3 层改用 Branch 平铺（§10）",
                    "body": {
                        "desc": "[jp] $1",
                        "recognition": "And",
                        "all_of": [
                            "$2"
                        ],
                        "inverse": true,
                        "timeout": 30000,
                        "next": [
                            "$0"
                        ]
                    }
                },
                {
                    "label": "Loop 工作节点",
                    "$comment": "守卫可用 Probe 或 Custom（Custom 的未命中必须是“不在页面”）；出口只有守卫失效与有限 timeout 两条，不设计数兜底；一页多段工作拆子 Loop，用 [JumpBack]<子 Loop> 串联（结构文档 §3/§4/§5）",
                    "body": {
                        "desc": "[Loop] $1",
                        "recognition": "And",
                        "all_of": [
                            "$2"
                        ],
                        "timeout": 30000,
                        "next": [
                            "$0"
                        ]
                    }
                },
                {
                    "label": "<动作> 动作节点",
                    "body": {
                        "desc": "$1",
                        "action": "$0",
                        "post_delay": 500
                    }
                },
                {
                    "label": "Task 任务入口",
                    "body": {
                        "desc": "$1任务",
                        "timeout": 30000,
                        "next": [
                            "$0"
                        ]
                    }
                }
            ]
        }
    }
}