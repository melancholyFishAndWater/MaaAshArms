{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "$comment": "使用命名规范 v3.5; 使用任务链结构 v4.0",
    "patternProperties": {
        "^(?!\\$).*": {
            "defaultSnippets": [
                {
                    "label": "<> 空节点",
                    "body": {
                        "desc": "$0"
                    }
                },
                {
                    "label": "Probe 探测节点",
                    "body": {
                        "desc": "[end] $1",
                        "recognition": "$0",
                        "roi": []
                    }
                },
                {
                    "label": "Branch 分支节点",
                    "$comment": "识别到该状态就把 next 交出去：不写 action、不保证页面、不回到自己（node-naming.md §3）。页面导航默认用它平铺到调用方 next；单探针直接写进 recognition，不再包一层 Probe（结构文档 §10）",
                    "body": {
                        "desc": "$1",
                        "recognition": "And",
                        "all_of": [
                            "$2"
                        ],
                        "next": [
                            "$0",
                            "[JumpBack]BaseBranchError"
                        ]
                    }
                },
                {
                    "label": "action 简单动作",
                    "$comment": "普通动作执行后等待下一步",
                    "body": {
                        "desc": "$1",
                        "recognition": "$2",
                        "roi": [],
                        "action": "Click",
                        "post_wait_freezes": 1000,
                        "next": [
                            "$0",
                            "[JumpBack]BaseBranchError"
                        ]
                    }
                },
                {
                    "label": "action 标准自环",
                    "$comment": "有限 max_hit 限制自环重试，BaseHitResetSink 在非自身且非 jp 叶子命中时清零父节点。",
                    "body": {
                        "desc": "[max] $1",
                        "max_hit": 10,
                        "recognition": "$2",
                        "roi": [],
                        "action": "Click",
                        "post_wait_freezes": 1000,
                        "next": [
                            "$4",
                            "${5:自身节点名}",
                            "[JumpBack]BaseBranchError"
                        ]
                    }
                },
                {
                    "label": "Task 任务入口",
                    "body": {
                        "desc": "$1任务",
                        "timeout": 30000,
                        "next": [
                            "$0"
                        ]
                    }
                }
            ]
        }
    }
}